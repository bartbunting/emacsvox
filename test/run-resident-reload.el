(let ((root (expand-file-name "../" (file-name-directory load-file-name))))
  (add-to-list 'load-path (expand-file-name "lisp/" root))
  (setq load-prefer-newer (not (getenv "OMNIVOX_TEST_BYTECODE")))
  (require 'emacsvox-preamble)
  (require 'tts-speak)
  (require 'omnivox-preferences)
  (require 'omnivox-library)
  (unless (getenv "OMNIVOX_TEST_BYTECODE")
    (dolist (file '("tts-speak.el" "omnivox-voices.el" "omnivox-punctuation-profiles.el" "omnivox-preferences.el"))
      (load file nil nil)))
  (setq emacsvox-servers-directory (expand-file-name "servers/" root))
  (dolist (symbol '(tts-initialize omnivox-reload-punctuation omnivox-reload-preferences omnivox--control-process-filter))
    (let ((file (symbol-file symbol 'defun)))
      (unless (and file (string-prefix-p root file)
                   (string-suffix-p (if (getenv "OMNIVOX_TEST_BYTECODE") ".elc" ".el") file))
        (error "Unexpected loaded file for %s: %s" symbol file))
      (princ (format "Loaded %s from %s\n" symbol file)))))
(require 'json)
(require 'omnivox-punctuation)
(defvar resident-test--expected-file nil)
(setq tts-program "omnivox" emacsvox-speak-messages nil
      tts-notification-device "both" debug-on-error t)
(unless (and (getenv "OMNIVOX_PROGRAM") (getenv "OMNIVOX_CONFIG_DIR") (getenv "OMNIVOX_VOICE_ROOT"))
  (error "Explicit isolated inputs are required"))
(defun resident-test--save (word index)
  (let* ((path (expand-file-name "config.json" (or (getenv "OMNIVOX_TEST_CONFIG_DIR") (getenv "OMNIVOX_CONFIG_DIR"))))
         (config (with-temp-buffer (insert-file-contents path)
                                   (json-parse-buffer :object-type 'hash-table :array-type 'array
                                                      :null-object :null :false-object :false))))
    (puthash "!" word (gethash "overrides" (gethash "probe" (gethash "punctuation_profiles" (gethash "speech" config)))))
    (when (getenv "OMNIVOX_TEST_HOST")
      (let ((speech (gethash "speech" config))
            (defaults (make-hash-table :test #'equal))
            (capitals (make-hash-table :test #'equal)))
        (puthash "max_chunk_words" (+ 15 index) speech)
        (puthash "rate" (+ .4 (* .05 (% index 5))) defaults)
        (puthash "default" (if (= 0 (% index 2)) "off" 1.5) capitals)
        (puthash "defaults" defaults speech)
        (puthash "capital_pitch" capitals speech)))
    (with-temp-file path (insert (json-serialize config :null-object :null :false-object :false)))))
(defun resident-test--reload ()
  (let ((start (float-time)) result)
    (if (getenv "OMNIVOX_TEST_HOST")
        (omnivox-reload-preferences (lambda (value) (setq result value)))
      (omnivox-reload-punctuation (lambda (value) (setq result value)) resident-test--expected-file))
    (while (and (not result) (< (float-time) (+ start 5))) (accept-process-output nil .002))
    (unless (and result (cl-every (lambda (r) (member (plist-get r :outcome) '("applied" "unchanged"))) result))
      (error "Reload did not complete: %S" result))
    (princ (format "Reload %.3f ms: %s\n" (* 1000 (- (float-time) start)) (omnivox-preferences--summary result)))))
(unwind-protect
    (progn
      (tts-initialize)
      (let ((speaker tts-speaker-process) (notify tts-notify-process))
        (unless (and (process-live-p speaker) (process-live-p notify)) (error "Incomplete pair"))
        (let ((deadline (+ (float-time) 10)))
          (while (and (< (float-time) deadline)
                      (not (and (omnivox--process-supports-p speaker "host_preferences_v1")
                                (omnivox--process-supports-p notify "host_preferences_v1"))))
            (accept-process-output nil .01)))
        (setq resident-test--expected-file
              (plist-get (omnivox-punctuation--request '(:command "punctuation-review")) :path))
        (dotimes (i 25)
          (resident-test--save (format "updated %d" i) i)
          (resident-test--reload)
          (tts-letter ?A)
          (accept-process-output nil .025))
        (unless (and (eq speaker tts-speaker-process) (eq notify tts-notify-process))
          (error "Reload replaced a worker"))
        (princ "PASS: 25 public two-worker reloads, character submissions, same owners\n")))
  (dolist (process (list tts-speaker-process tts-notify-process))
    (when (processp process) (tts--retire-process process))))
