                            'emacsvox-tone-editor-waveform)))
              (execute-kbd-macro (kbd "w <down> RET"))
              (should (eq (emacsvox-tone-editor--get :waveform) 'triangle))
              (should (equal emacsvox-flyspell-tone-shape '(:waveform sine)))
              (execute-kbd-macro (kbd "e a"))
              (should (eq (emacsvox-tone-editor--get :envelope) 'adsr))
              (execute-kbd-macro (kbd "? a"))
              (with-current-buffer "*Help*"
                (should (string-match-p "silence to peak level" (buffer-string))))
              (execute-kbd-macro (kbd "q"))
              (should (eq (oref transient--prefix command) 'emacsvox-tone-editor))
              (execute-kbd-macro (kbd "q"))
              (should (eq (oref transient--prefix command) 'emacsvox-spelling))
              (with-selected-window transient--window
                (should (eq (oref (button-get (button-at (point)) 'button-data) command)
                            'emacsvox-spelling--edit-tone)))
              (execute-kbd-macro (kbd "E"))
              (should (= (emacsvox-tone-editor--get :pitch) 880))
              (should (eq (emacsvox-tone-editor--get :waveform) 'sine))
              (execute-kbd-macro (kbd "w p"))
              (with-selected-window transient--window
                (transient--goto-button (transient-suffix-object 'emacsvox-tone-editor--width)))
              (execute-kbd-macro (kbd "S-<right>"))
              (should (= (emacsvox-tone-editor--get :width) 55))
              (cl-letf (((symbol-function 'emacsvox-aural-menu--read-number) (lambda (&rest _) 25)))
                (execute-kbd-macro (kbd "RET")))
              (execute-kbd-macro (kbd "w s w p"))
              (should (= (emacsvox-tone-editor--get :width) 25))
              (execute-kbd-macro (kbd "t e a k e"))
              (execute-kbd-macro (kbd "<left> <down>"))
              (execute-kbd-macro (kbd "S-<right>"))
              (should (= (emacsvox-tone-editor--get :end-pitch) 905))
              (should (eq (emacsvox-tone-editor--get :curve) 'exponential))
              (should (equal emacsvox-flyspell-tone-shape '(:waveform sine)))
              (execute-kbd-macro (kbd "? u"))
              (with-current-buffer "*Help*"
                (should (string-match-p "Only Pulse uses this value" (buffer-string))))
              (execute-kbd-macro (kbd "q q E"))
              (execute-kbd-macro (kbd "L <down>"))
              (should (= (emacsvox-tone-editor--get :pitch) 880))
              (execute-kbd-macro (kbd "? 2"))
              (with-current-buffer "*Help*"
                (should (string-match-p "gradual onset" (buffer-string))))
              (execute-kbd-macro (kbd "q q"))
              (should (eq (oref transient--prefix command) 'emacsvox-tone-editor))
              (should (= (emacsvox-tone-editor--get :pitch) 880))
              (execute-kbd-macro (kbd "L <down> RET"))
              (should (= (emacsvox-tone-editor--get :pitch) 660))
              (should (= emacsvox-flyspell-tone-pitch 880))
              (execute-kbd-macro (kbd "w r e c A q E"))
              (should (eq (emacsvox-tone-editor--get :waveform) 'square))
              (execute-kbd-macro (kbd "R q"))
              (should (equal emacsvox-flyspell-tone-shape '(:waveform square))))
          (when transient--prefix (execute-kbd-macro (kbd "C-q"))))))))

(ert-deftest emacsvox-spelling-switches-graphical-save-survives-restart ()
  "Save switches with S after tone editing and restore them in a fresh Emacs."
  (skip-unless (display-graphic-p))
  (require 'emacsvox-advice)
  (let* ((custom-file (make-temp-file "emacsvox-spelling-switches-" nil ".el"))
         (user-init-file nil)
         (symbols (append emacsvox-spelling--options '(tts-main-tone-volume)))
         (defaults (mapcar (lambda (symbol) (cons symbol (default-value symbol))) symbols))
         (properties (mapcar (lambda (symbol) (cons symbol (copy-tree (symbol-plist symbol)))) symbols))
         (switches '(emacsvox-flyspell-use-voice emacsvox-flyspell-use-tone
                     emacsvox-flyspell-use-earcon)))
    (unwind-protect
        (save-window-excursion
          (emacsvox-test--with-aural-menu
            ;; A manually loaded -q profile has no init identity until setup
            ;; completes.  Save must fail without announcing success.
            (let (spoken)
              (cl-letf (((symbol-function 'emacsvox-spelling--say)
                         (lambda (text) (push text spoken))))
                (should-error (emacsvox-spelling--save) :type 'user-error))
              (should-not spoken))
            (should (zerop (file-attribute-size (file-attributes custom-file))))
            (setq user-init-file custom-file)
            (switch-to-buffer source)
            (local-set-key (kbd "<f8>") #'emacsvox-aural-menu)
            (cl-mapc #'set-default switches '(t nil t))
            (let ((transient--prefix nil) (transient-show-menu t))
              (unwind-protect
                  (progn
                    (execute-kbd-macro (kbd "<f8> s f"))
                    (dolist (expected '((nil t nil) (t nil t)))
                      (execute-kbd-macro (kbd "v t e E q S"))
                      (should (eq (oref transient--prefix command) 'emacsvox-spelling))
                      (should (equal (mapcar #'default-value switches) expected))
                      (should (> (file-attribute-size (file-attributes custom-file)) 0))
                      ;; Support Customize loaded before or after the menu.
                      (dolist (custom-first '(t nil))
                        (with-temp-buffer
                          (let* ((load-custom `(load ,custom-file nil t))
                                 (load-menu '(require 'emacsvox-spelling))
                                 (check
                                  `(progn
                                     ,(if custom-first load-custom load-menu)
                                     ,(if custom-first load-menu load-custom)
                                     (unless (equal (mapcar #'default-value ',switches) ',expected)
                                       (error "Spelling switches reverted after restart"))
                                     (cl-mapc
                                      (lambda (symbol value label)
                                        (unless (equal (emacsvox-spelling--label symbol label)
                                                       (concat label (if value ": on" ": off")))
                                          (error "Spelling menu displays stale switch state")))
                                      ',switches ',expected '("Voice" "Tone" "Earcon"))))
                                 (status
                                  (call-process
                                   (expand-file-name invocation-name invocation-directory)
                                   nil (current-buffer) nil "-Q" "--batch"
                                   "-L" emacsvox-lisp-directory "-l" "emacsvox-preamble.el"
                                   "--eval" (prin1-to-string check))))
                            (ert-info ((buffer-string)) (should (equal status 0))))))))
                (when transient--prefix (execute-kbd-macro (kbd "C-q")))))))
      (dolist (entry defaults) (set-default (car entry) (cdr entry)))
      (dolist (entry properties) (setplist (car entry) (cdr entry)))
      (when (get-file-buffer custom-file) (kill-buffer (get-file-buffer custom-file)))
      (delete-file custom-file))))

(defun emacsvox-test--capture-menu-preview (command)
  "Call COMMAND through real speech preparation and capture its wire output."
  (let* ((process (make-pipe-process :name "menu-preview-test" :noquery t))
         (tts-speaker-process process) (tts-notify-process nil)
         (tts-program "omnivox") (tts-quiet nil) (tts-stop-immediately nil)
         (tts-handle-unicode nil) (voice-lock-mode t)
         (tts-punctuation-mode 'none) (emacsvox-pronounce-table nil)
         (tts-get-voice-command (lambda (_voice) ""))
         writes)
    (unwind-protect
        (progn
          (process-put process emacsvox-aural--structured-timeline-process-property 3)
          (process-put process tts--tracked-playback-completion-property t)
          (process-put process emacsvox-aural--presentation-tone-process-property 1)
          (process-put process tts--capitalization-presentation-property t)
          (cl-letf (((symbol-function 'process-send-string)
                     (lambda (_process text) (push text writes)))
                    ((symbol-function 'tts-voice-reset-code) (lambda () "")))
            (funcall command)
            (emacsvox-aural-flush-pending-deliveries process))
          (let ((wire (apply #'concat (nreverse writes))))
            (should (string-match "emacsvox_timeline {\\([^}]+\\)}" wire))
            (list :wire wire :timeline
                  (json-parse-string
                   (decode-coding-string (base64-decode-string (match-string 1 wire)) 'utf-8)
                   :object-type 'plist :array-type 'list))))
      (delete-process process))))

(ert-deftest emacsvox-capitalization-preview-transmits-camel-case-choice ()
  "The displayed camel-case choice reaches the speech worker for every preview."
  (require 'emacsvox-capitalization)
  (emacsvox-test--with-transport-scheme
    (with-temp-buffer
      (setq-local tts-caps t emacsvox-capitalization-presentation 'tone)
      (let* ((context (emacsvox-aural-menu--capture nil))
             (transient--prefix (transient-prefix :command 'emacsvox-capitalization :scope context)))
        (dolist (split '(nil t))
          (setq-local tts-split-caps split)
          (let* ((result (emacsvox-test--capture-menu-preview #'emacsvox-capitalization--preview))
                 (wire (plist-get result :wire))
                 (text (mapconcat (lambda (span) (plist-get span :text))
                                  (plist-get (plist-get result :timeline) :spans) "")))
            (should (string-match-p (format "tts_sync_state none %d 0 " (if split 1 0)) wire))
            (should (string-match-p "readWriteBuffer" text))
            (should (string-match-p "saveCurrentFile" text))))))))

(ert-deftest emacsvox-spelling-preview-keeps-active-capitalization ()
  "Spelling samples obey the source's capitalization indication and presentation."
  (emacsvox-test--with-transport-scheme
    (with-temp-buffer
      (setq-local tts-caps t tts-split-caps nil)
      (let* ((context (emacsvox-aural-menu--capture nil))
             (transient--prefix (transient-prefix :command 'emacsvox-spelling :scope context))
             (emacsvox-flyspell-use-tone nil) (emacsvox-flyspell-use-earcon nil))
        (dolist (presentation '(tone spoken none))
          (setq-local emacsvox-capitalization-presentation presentation)
          (let* ((result (emacsvox-test--capture-menu-preview #'emacsvox-spelling--preview))
                 (timeline (plist-get result :timeline))
                 (text (mapconcat (lambda (span) (plist-get span :text)) (plist-get timeline :spans) ""))
                 (tones (seq-filter (lambda (a) (equal (plist-get a :type) "tone"))
                                    (plist-get timeline :actions))))
            (should (= (length tones) (if (eq presentation 'tone) 1 0)))
            (should (eq (and (string-match-p "cap" (downcase text)) t)
                        (eq presentation 'spoken)))))))))

(ert-deftest emacsvox-capitalization-samples-contain-several-owned-beeps ()
  "Both samples produce several beeps of the edited kind without applying it."
  (require 'emacsvox-capitalization)
  (emacsvox-test--with-transport-scheme
    (with-temp-buffer
      (let ((emacsvox-capitalization--drafts (make-hash-table :test #'eq)))
        (dolist (kind '(capital all-caps))
          (let* ((context (plist-put (emacsvox-aural-menu--capture nil) :cue-draft
                                     (emacsvox-capitalization--draft kind)))
                 (transient--prefix (transient-prefix :command 'emacsvox-capitalization-cue :scope context))
                 (before (copy-tree (default-value (emacsvox-capitalization--option kind))))
                 (result (emacsvox-test--capture-menu-preview
                          (lambda () (emacsvox-capitalization--preview-tone
                                      (emacsvox-tone-editor--data 875 30 100 '(:waveform sine)) t))))
                 (tones (seq-filter (lambda (a) (equal (plist-get a :type) "tone"))
                                    (plist-get (plist-get result :timeline) :actions))))
            (should (>= (length tones) 5))
            (dolist (tone tones) (should (= (plist-get tone :frequency_hz) 875)))
            (should (equal before (default-value (emacsvox-capitalization--option kind))))))))))

