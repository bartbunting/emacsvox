(ert-deftest emacsvox-spelling-combinations-reach-word-position ()
  "Every combination keeps speech and anchors only selected cues at the word."
  (dolist (voice '(nil t))
    (dolist (tone '(nil t))
      (dolist (earcon '(nil t))
        (emacsvox-test--with-transport-scheme
          (let* ((emacsvox-flyspell-use-voice voice)
                 (emacsvox-flyspell-use-tone tone)
                 (emacsvox-flyspell-use-earcon earcon)
                 (emacsvox-flyspell-tone-pitch 725)
                 (emacsvox-flyspell-tone-duration 65)
                 (emacsvox-flyspell-tone-volume 100)
                 (timeline (plist-get (emacsvox-test--capture-native-timeline
                                       (emacsvox-spelling--sample)) :timeline))
                 (spans (plist-get timeline :spans))
                 (actions (seq-filter (lambda (action)
                                        (member (plist-get action :type) '("tone" "audio")))
                                      (plist-get timeline :actions))))
            (should (equal (mapconcat (lambda (span) (plist-get span :text)) spans "")
                           "This mispeled word needs checking."))
            (should (= (length actions) (+ (if tone 1 0) (if earcon 1 0))))
            (should (eq (and (seq-some (lambda (span)
                                        (equal (plist-get span :logical_voice_id) "bolden")) spans) t)
                        voice))
            (dolist (action actions)
              (let* ((position (plist-get action :position))
                     (span-id (plist-get position :span_id))
                     (offset (plist-get position :utf8_offset))
                     (span (seq-find (lambda (span) (= (plist-get span :id) span-id)) spans)))
                (should (equal (plist-get position :affinity) "before"))
                (should (string-prefix-p "mispeled" (substring (plist-get span :text) offset)))
                (when (equal (plist-get action :type) "tone")
                  (should (= (plist-get action :frequency_hz) 725))
                  (should (= (plist-get action :duration_ms) 65)))))))))))

(ert-deftest emacsvox-spelling-source-keeps-overlays-and-other-voices ()
  "Reading captures real Flyspell overlays without editing source or repeating cues."
  (emacsvox-test--with-transport-scheme
    (with-temp-buffer
      (insert "Parham Doustdar <parham90@gmail.com> writes:")
      (setq-local flyspell-mode t)
      (let ((first (make-flyspell-overlay 1 7 'flyspell-incorrect 'highlight))
            (second (make-flyspell-overlay 8 16 'flyspell-duplicate 'highlight))
            (emacsvox-flyspell-use-voice nil)
            (emacsvox-flyspell-use-tone t)
            (emacsvox-flyspell-use-earcon t)
            (emacsvox-use-icons t)
            icons)
        (put-text-property 36 42 'personality 'voice-animate)
        (set-buffer-modified-p nil)
        (let* ((original (buffer-substring (point-min) (point-max)))
               (text (emacsvox-aural-source-substring (point-min) (point-max)))
               (annotated (emacsvox-flyspell--annotate text)))
          (should (equal-including-properties original (buffer-substring (point-min) (point-max))))
          (should-not (buffer-modified-p))
          (should (eq (overlay-get first 'face) 'flyspell-incorrect))
          (should (eq (overlay-get second 'face) 'flyspell-duplicate))
          (should (eq (get-text-property 35 'personality annotated) 'voice-animate))
          (should-not (get-text-property 0 emacsvox-aural-source-faces-property annotated))
          (should (get-text-property 0 emacsvox-aural-positioned-facts-property annotated))
          (should (get-text-property 7 emacsvox-aural-positioned-facts-property annotated))
          (cl-letf (((symbol-function 'emacsvox-icon) (lambda (icon) (push icon icons)))
                    ((symbol-function 'emacsvox-aural-submit-actions)
                     (lambda (&rest _) (push 'tone icons))))
            (emacsvox-flyspell--incorrect 1 7 '("replacement"))
            (should-not icons)
            (emacsvox-flyspell--clear-read-errors)
            (emacsvox-flyspell--incorrect 1 7 '("replacement"))
            (should (equal icons '(tone)))))))))

(ert-deftest emacsvox-spelling-menu-preview-and-save ()
  "Preview uses current settings without saving; Save persists only owned options."
  (emacsvox-test--with-aural-menu
    (let ((transient--prefix (transient-prefix :command 'emacsvox-spelling :scope context))
          (emacsvox-flyspell-tone-pitch 880)
          (emacsvox-flyspell-tone-duration 40)
          (emacsvox-flyspell-tone-volume 100)
          (emacsvox-flyspell-tone-timing 'overlay)
          (tts-main-tone-volume 70)
          heard saved)
      (cl-letf (((symbol-function 'emacsvox-spelling--say) #'ignore)
                ((symbol-function 'tts-speak) (lambda (text) (setq heard text)))
                ((symbol-function 'customize-save-variable)
                 (lambda (symbol value &rest _) (push (cons symbol value) saved))))
        (emacsvox-spelling--pitch 1)
        (emacsvox-spelling--duration -1)
        (emacsvox-spelling--volume -1)
        (should (= emacsvox-flyspell-tone-volume 95))
        (should (= tts-main-tone-volume 70))
        (should (= emacsvox-flyspell-tone-pitch 905))
        (should (= emacsvox-flyspell-tone-duration 35))
        (let ((emacsvox-flyspell-use-tone nil)) (emacsvox-spelling--preview))
        (should (get-text-property 5 'emacsvox-flyspell-word heard))
        (should-not saved)
        (emacsvox-spelling--save)
        (should (= (cdr (assq 'emacsvox-flyspell-tone-pitch saved)) 905))
        (should (= (cdr (assq 'emacsvox-flyspell-tone-volume saved)) 95))
        (should (= (cdr (assq 'tts-main-tone-volume saved)) 70))
        (should (eq (cdr (assq 'emacsvox-flyspell-tone-timing saved)) 'overlay))
        (should (= (length saved) 9))))))

