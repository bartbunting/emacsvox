(ert-deftest emacsvox-spelling-tone-preview-interrupts-main-before-delivery ()
  "Preview replaces existing main speech without stopping notifications."
  (omnivox-native-runtime-test--with-speech
    (omnivox-rich-tone-test--enable speaker)
    (with-temp-buffer
      (let ((transient--prefix
             (transient-prefix :command 'emacsvox-spelling
                               :scope (emacsvox-aural-menu--capture nil)))
            (emacsvox-flyspell-tone-shape '(:waveform sine))
            (emacsvox-flyspell-tone-volume 100)
            (emacsvox-aural-submission-delivery-policy nil)
            events)
        (cl-letf (((symbol-function 'tts--interrupt-process)
                   (lambda (owner &optional notifications _preserved)
                     (push (list 'stop owner notifications) events)))
                  ((symbol-function 'process-send-string)
                   (lambda (owner text) (push (list 'write owner text) events))))
          (emacsvox-spelling--preview-tone)
          (setq events (nreverse events))
          (should (equal (car events) (list 'stop speaker nil)))
          (should (equal (seq-filter (lambda (event) (eq (car event) 'stop)) events)
                         (list (list 'stop speaker nil))))
          (should (seq-some (lambda (event)
                              (and (eq (car event) 'write)
                                   (eq (cadr event) speaker)
                                   (string-match-p "emacsvox_tone" (caddr event))))
                            (cdr events)))
          ;; Unsupported previews must fail before disturbing current speech.
          (setq events nil)
          (process-put speaker emacsvox-aural--presentation-tone-process-property 1)
          (let ((emacsvox-flyspell-tone-volume 35))
            (should-error (emacsvox-spelling--preview-tone) :type 'user-error))
          (should-not events))))))

(ert-deftest emacsvox-spelling-volume-and-timing-match-reading-editing-and-preview ()
  (omnivox-native-runtime-test--with-speech
   (omnivox-rich-tone-test--enable speaker)
   (process-put speaker omnivox--choice-registration-property nil)
   (omnivox-native-runtime-test--register)
   (dolist (emacsvox-flyspell-tone-timing '(insert overlay))
     (with-temp-buffer
       (insert "misspelt word")
       (let ((transient--prefix (transient-prefix :command 'emacsvox-spelling
                                                  :scope (emacsvox-aural-menu--capture nil)))
             (emacsvox-use-icons t)
             (emacsvox-flyspell-tone-pitch 880)
             (emacsvox-flyspell-tone-duration 40)
             (emacsvox-flyspell-tone-volume 35)
             (emacsvox-flyspell-use-tone t)
             (emacsvox-flyspell-use-earcon nil)
             (emacsvox-flyspell--read-errors nil))
         (setq writes nil)
         (emacsvox-spelling--preview)
         (let* ((document (omnivox-choice-consumer-test--timeline (car writes)))
                (tone (seq-find (lambda (action) (equal (plist-get action :type) "tone"))
                                (plist-get document :actions))))
           (should (= (plist-get document :protocol_version) 6))
           (should (= (plist-get tone :volume) 0.35))
           (should (equal (plist-get tone :mode) (symbol-name emacsvox-flyspell-tone-timing))))
         (dolist (action (list #'emacsvox-spelling--preview-tone
                               (lambda () (emacsvox-flyspell--incorrect 1 5 '("word")))))
           (setq writes nil)
           (funcall action)
           (should (seq-some (lambda (write)
                               (string-match-p
                                (format "emacsvox_tone 2 %s 880 40 0.35 sine classic"
                                        emacsvox-flyspell-tone-timing)
                                (cdr write)))
                             writes))))))))

(ert-deftest emacsvox-spelling-menu-graphical-navigation ()
  "Enter from Speech settings, adjust focused pitch, and return to its item."
  (skip-unless (display-graphic-p))
  (save-window-excursion
    (emacsvox-test--with-aural-menu
      (switch-to-buffer source)
      (local-set-key (kbd "<f8>") #'emacsvox-aural-menu)
      (let ((transient--prefix nil) (transient-show-menu t)
            (emacsvox-flyspell-use-tone nil)
            (emacsvox-flyspell-tone-pitch 880)
            (emacsvox-flyspell-tone-timing 'insert)
            (emacsvox-flyspell-tone-volume 100))
        (unwind-protect
            (progn
              (execute-kbd-macro (kbd "<f8> s f t"))
              (should (eq (oref transient--prefix command) 'emacsvox-spelling))
              (should emacsvox-flyspell-use-tone)
              (with-selected-window transient--window
                (transient--goto-button
                 (seq-find (lambda (suffix) (eq (oref suffix command) 'emacsvox-spelling--pitch))
                           transient--suffixes)))
              (execute-kbd-macro (kbd "S-<right>"))
              (should (= emacsvox-flyspell-tone-pitch 905))
              (with-selected-window transient--window
                (transient--goto-button
                 (seq-find (lambda (suffix) (eq (oref suffix command) 'emacsvox-spelling--volume))
                           transient--suffixes)))
              (execute-kbd-macro (kbd "S-<left>"))
              (should (= emacsvox-flyspell-tone-volume 95))
              (cl-letf (((symbol-function 'emacsvox-aural-menu--read-number) (lambda (&rest _) 35)))
                (execute-kbd-macro (kbd "RET")))
              (should (= emacsvox-flyspell-tone-volume 35))
              (should (string-match-p "shared" (documentation 'emacsvox-spelling--volume)))
              (execute-kbd-macro (kbd "m <down>"))
              (should (eq (oref transient--prefix command) 'emacsvox-spelling-timing))
              (should (eq emacsvox-flyspell-tone-timing 'insert))
              (execute-kbd-macro (kbd "q"))
              (with-selected-window transient--window
                (should (eq (oref (button-get (button-at (point)) 'button-data) command)
                            'emacsvox-spelling-timing)))
              (execute-kbd-macro (kbd "m <down> RET"))
              (should (eq emacsvox-flyspell-tone-timing 'overlay))
              (should (eq (oref transient--prefix command) 'emacsvox-spelling))
              (with-selected-window transient--window
                (should (eq (oref (button-get (button-at (point)) 'button-data) command)
                            'emacsvox-spelling-timing)))
              (execute-kbd-macro (kbd "m"))
              (with-selected-window transient--window
                (should (eq (oref (button-get (button-at (point)) 'button-data) command)
                            'emacsvox-spelling--alongside)))
              (execute-kbd-macro (kbd "? a"))
              (with-current-buffer "*Help*"
                (should (string-match-p "without inserting tone pauses" (buffer-string))))
              (execute-kbd-macro (kbd "q"))
              (should (eq (oref transient--prefix command) 'emacsvox-spelling-timing))
              (execute-kbd-macro (kbd "q"))
              (execute-kbd-macro (kbd "q"))
              (should (eq (oref transient--prefix command) 'emacsvox-aural-menu-speech)))
          (when transient--prefix (execute-kbd-macro (kbd "C-q"))))))))


(defmacro emacsvox-tone-test--with-draft (&rest body)
  "Run BODY with a private spelling draft and source context."
  (declare (indent 0) (debug t))
  `(emacsvox-test--with-aural-menu
     (let* ((emacsvox-flyspell-tone-pitch 880)
            (emacsvox-flyspell-tone-duration 40)
            (emacsvox-flyspell-tone-volume 35)
            (emacsvox-flyspell-tone-timing 'overlay)
            (emacsvox-flyspell-tone-shape '(:waveform sine))
            (provider (list :label "Spelling tone (global draft)"
                            :read #'emacsvox-spelling--tone-data
                            :apply #'emacsvox-spelling--apply-tone
                            :preview #'emacsvox-spelling--preview-draft))
            (state (list :provider provider :draft (emacsvox-spelling--tone-data)))
            (transient--prefix
             (transient-prefix :command 'emacsvox-tone-editor
                               :scope (append (list :tone-editor state) context))))
       ,@body)))

(ert-deftest emacsvox-tone-editor-draft-preview-apply-and-save ()
  (emacsvox-tone-test--with-draft
    (let (sample tone heard saved)
      (cl-letf (((symbol-function 'emacsvox-tone-editor--say) (lambda (text) (push text heard)))
                ((symbol-function 'emacsvox-spelling--preview)
                 (lambda () (setq sample (list emacsvox-flyspell-tone-pitch emacsvox-flyspell-tone-shape
                                                emacsvox-flyspell-use-tone emacsvox-flyspell-tone-timing))))
                ((symbol-function 'emacsvox-spelling--preview-tone)
                 (lambda () (setq tone emacsvox-flyspell-tone-shape)))
                ((symbol-function 'customize-save-variable)
                 (lambda (symbol value &rest _) (push (cons symbol value) saved))))
        (emacsvox-tone-editor--number :pitch 1)
        (should (equal heard '("905 Hz")))
        (emacsvox-tone-editor--put :waveform 'triangle)
        (emacsvox-tone-editor--put :envelope 'adsr)
        ;; Timing can change outside this draft and must remain authoritative.
        (setq emacsvox-flyspell-tone-timing 'insert)
        (emacsvox-tone-editor--sample)
        (emacsvox-tone-editor--tone)
        (should (= (car sample) 905))
        (should (nth 2 sample))
        (should (eq (nth 3 sample) 'insert))
        (should (equal (cadr sample) tone))
        (should (= emacsvox-flyspell-tone-pitch 880))
        (should (equal emacsvox-flyspell-tone-shape '(:waveform sine)))
        (should-not saved)
        (emacsvox-tone-editor--apply)
        (should (= emacsvox-flyspell-tone-pitch 905))
        (should (equal emacsvox-flyspell-tone-shape tone))
        (emacsvox-tone-editor--save)
        (should (= (length saved) 4))
        (should-not (assq 'emacsvox-flyspell-tone-timing saved))
        (should (eq emacsvox-flyspell-tone-timing 'insert))
        (should (equal (cdr (assq 'emacsvox-flyspell-tone-shape saved)) tone))
        (should-not (assq 'tts-main-tone-volume saved))
        (emacsvox-tone-editor--reset)
        (should-not (plist-member (plist-get state :draft) :timing))
        (should (eq emacsvox-flyspell-tone-timing 'insert))
        (should (eq (emacsvox-tone-editor--get :waveform) 'sine))
        (should (equal emacsvox-flyspell-tone-shape tone))))))

(ert-deftest emacsvox-tone-editor-presets-and-comparison-stay-private ()
  (emacsvox-tone-test--with-draft
    (let ((emacsvox-tone-presets nil) heard saved)
      (cl-letf (((symbol-function 'emacsvox-tone-editor--say) #'ignore)
                ((symbol-function 'transient--stack-pop) #'ignore)
                ((symbol-function 'transient--show) #'ignore)
                ((symbol-function 'emacsvox-spelling--preview-tone)
                 (lambda () (push emacsvox-flyspell-tone-pitch heard)))
                ((symbol-function 'customize-save-variable)
                 (lambda (symbol value &rest _) (setq saved (cons symbol value)))))
        (emacsvox-tone-editor--load-preset "Rounded beep" (cddr (nth 1 emacsvox-tone-editor--presets)))
        (emacsvox-tone-editor--tone)
        (emacsvox-tone-editor--current)
        (should (equal heard '(880 660)))
        (should (= emacsvox-flyspell-tone-pitch 880))
        (emacsvox-tone-editor--number :pitch 1)
        (should (= (plist-get (cddr (nth 1 emacsvox-tone-editor--presets)) :pitch) 660))
        (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "My cue")))
          (emacsvox-tone-editor--save-preset))
        (should (eq (car saved) 'emacsvox-tone-presets))
        (should (= (plist-get (cdr (assoc "My cue" (cdr saved))) :pitch) 685))
        (should (= emacsvox-flyspell-tone-pitch 880))
        (emacsvox-tone-editor--apply)
        (emacsvox-tone-editor--current)
        (should (= (car heard) 685))
        (setq emacsvox-tone-presets (cdr saved))
        (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "my cue"))
                  ((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
          (should-error (emacsvox-tone-editor--save-preset) :type 'user-error))
        (should (= (length emacsvox-tone-presets) 1))))))

