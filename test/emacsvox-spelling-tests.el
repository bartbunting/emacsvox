(ert-deftest emacsvox-tone-editor-graphical-draft-and-choice-navigation ()
  (skip-unless (display-graphic-p))
  (save-window-excursion
    (emacsvox-test--with-aural-menu
      (switch-to-buffer source)
      (local-set-key (kbd "<f8>") #'emacsvox-aural-menu)
      (let ((transient--prefix nil) (transient-show-menu t)
            (emacsvox-flyspell-tone-pitch 880)
            (emacsvox-flyspell-tone-shape '(:waveform sine)))
        (unwind-protect
            (progn
              (execute-kbd-macro (kbd "<f8> s f E"))
              (should (eq (oref transient--prefix command) 'emacsvox-tone-editor))
              (execute-kbd-macro (kbd "? ?"))
              (should (derived-mode-p 'emacsvox-transient-mode))
              (should (string-match-p "plays the draft tone alone" (buffer-string)))
              (should (string-match-p "S stops, without saving" (buffer-string)))
              (should (string-match-p "C-c l: Repeat the selected item" (buffer-string)))
              (should (string-match-p "discards unapplied edits" (buffer-string)))
              (execute-kbd-macro (kbd "q"))
              (should (eq (oref transient--prefix command) 'emacsvox-tone-editor))
              (with-current-buffer transient--buffer
                (should (string-match-p "Spelling tone (global draft)" (buffer-string)))
                (should-not (string-match-p "Timing:" (buffer-string)))
                (should (= 1 (how-many "Play tone alone" (point-min) (point-max))))
                (should (string-match-p "Duration:.*Shift arrows.*5 ms" (buffer-string)))
                (dolist (label '("Waveform:" "Envelope:" "Curve:"))
                  (goto-char (point-min))
                  (search-forward label)
                  (should-not (string-match-p
                               "[Aa]rrows"
                               (buffer-substring-no-properties
                                (line-beginning-position) (line-end-position))))))
              (let (previews)
                (cl-letf (((symbol-function 'emacsvox-spelling--preview-draft)
                           (lambda (_data sample) (push (if sample 'sample 'tone) previews))))
                  (execute-kbd-macro (kbd "SPC"))
