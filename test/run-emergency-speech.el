(require 'cl-lib)
(defvar emergency-test--root
  (file-name-as-directory
   (or (getenv "OMNIVOX_TEST_SOURCE_ROOT")
       (expand-file-name "../" (file-name-directory load-file-name)))))
(add-to-list 'load-path (expand-file-name "lisp/" emergency-test--root))
(setq load-prefer-newer (not (getenv "OMNIVOX_TEST_BYTECODE")))
(require 'emacsvox-preamble)
(require 'tts-speak)
(require 'omnivox-library-runtime)
(require 'omnivox-voices)
(unless (getenv "OMNIVOX_TEST_BYTECODE")
  (dolist (file '("tts-speak.el" "tts-lifecycle.el" "omnivox-library-runtime.el" "omnivox-voices.el"))
    (load file nil nil)))
(setq emacsvox-servers-directory (expand-file-name "servers/" emergency-test--root)
      tts-program "omnivox" tts-notification-device "both" emacsvox-speak-messages nil
      debug-on-error t)
(dolist (function '(tts-emergency-start tts--recover-speaker omnivox-library--retire-for-emergency))
  (let ((file (symbol-file function 'defun)))
    (unless (and (string-prefix-p emergency-test--root file)
                 (string-suffix-p (if (getenv "OMNIVOX_TEST_BYTECODE") ".elc" ".el") file))
      (error "Wrong implementation %S: %S" function file))
    (princ (format "Loaded %s from %s\n" function file))))
(unless (and (getenv "OMNIVOX_PROGRAM") (getenv "OMNIVOX_TEST_CONFIG_DIR")
             (getenv "OMNIVOX_TEST_VOICE_ROOT"))
  (error "Explicit isolated executable, configuration and voice root required"))

(defun emergency-test--wait (predicate)
  (let ((deadline (+ (float-time) 10)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil .005))
    (unless (funcall predicate) (error "Emergency observation timed out"))))

(defun emergency-test--speech (engine)
  (emergency-test--wait
   (lambda () (and (condition-case nil (omnivox--choice-current-registration tts-speaker-process)
                    (error nil))
                  (cl-every
                   (lambda (process)
                     (let ((pending (process-get process omnivox--control-pending-property)))
                       (or (not pending) (= 0 (hash-table-count pending)))))
                   (list tts-speaker-process tts-notify-process)))))
  (let ((start (float-time)) terminal actual first)
    (tts-speak-marked "Emergency speech works."
                      (lambda (_id record)
                        (when (equal (plist-get record :type) "utterance_started")
                          (setq actual (plist-get record :engine_id))
                          (unless first (setq first (float-time)))))
                      (lambda (_id status) (setq terminal status)))
    (emergency-test--wait (lambda () terminal))
    (unless (and (eq terminal 'completed) (equal actual engine))
      (error "Wrong speech result: %S %S" terminal actual))
    (princ (format "Speech %s source %.3f ms, completion %.3f ms\n"
                   engine (* 1000 (- first start)) (* 1000 (- (float-time) start))))
    (list :submitted start :first first :completed (float-time))))

(defun emergency-test--fingerprints (root)
  (mapcar (lambda (file)
            (cons file (with-temp-buffer (insert-file-contents-literally file)
                                         (secure-hash 'sha256 (current-buffer)))))
          (directory-files-recursively root ".")))

(let* ((root (getenv "OMNIVOX_TEST_VOICE_ROOT"))
       (sessions (expand-file-name "sessions" root))
       (windows (string-suffix-p ".exe" (getenv "OMNIVOX_PROGRAM") t))
       (ordinary-engine (or (getenv "OMNIVOX_ENGINE") "flite")))
  (unwind-protect
      (progn
        (tts-initialize)
        (emergency-test--speech ordinary-engine)
        (let ((peer tts-notify-process)
              (peer-registration (process-get tts-notify-process omnivox--choice-registration-property))
              (original-request (symbol-function 'omnivox-library--request)) dropped retire-start retire-end)
          (let ((tts-speaker-process peer)) (emergency-test--speech ordinary-engine))
          (with-temp-file (expand-file-name "config.json" (getenv "OMNIVOX_TEST_CONFIG_DIR"))
            (insert "{broken preferences"))
          (with-temp-file (expand-file-name "host.json" root) (insert "{broken host"))
          (if windows
              (dolist (process (list tts-speaker-process peer))
                (make-directory (expand-file-name
                                 (concat (plist-get (process-get process 'omnivox-library-owner) :worker) ".retired")
                                 sessions)))
            (set-file-modes sessions #o500))
          (let ((before (emergency-test--fingerprints root))
                (omnivox-disabled-engine-ids '("espeak"))
                (omnivox-engine-priority-ids '("flite"))
                (start (float-time)) notice-submit notice-first notice-end notice-engine timer)
            (setq timer
                  (run-at-time .01 nil
                               (lambda ()
                                 (let ((tts-speaker-process peer))
                                   (setq notice-submit (float-time))
                                   (tts-speak-marked
                                    "Notice."
                                    (lambda (_id record)
                                      (when (equal (plist-get record :type) "utterance_started")
                                        (unless notice-first (setq notice-first (float-time)))
                                        (setq notice-engine (plist-get record :engine_id))))
                                    (lambda (_id status)
                                      (when (eq status 'completed) (setq notice-end (float-time)))))))))
            (cl-letf (((symbol-function 'omnivox-library--request)
                       (lambda (process command &optional owner)
                         (when (and (not retire-start) (equal (plist-get command :command) "retire-native"))
                           (setq retire-start (float-time)))
                         (let ((response (funcall original-request process command owner)))
                           (if (and (not dropped) (equal (plist-get command :command) "retire-native"))
                               (progn
                                 (unless (eq (plist-get response :retirement_recorded) :false)
                                   (error "Fixture did not prevent the management write"))
                                 (setq dropped t)
                                 (setq retire-end (float-time))
                                 (error "Injected lost native retirement reply"))
                             response)))))
              (tts-emergency-start "null"))
            (unless dropped (error "Lost reply was not exercised"))
            (cancel-timer timer)
            (let ((recovery-end (float-time)))
              (unless (and notice-submit (< notice-submit recovery-end))
                (error "Notification was not submitted during emergency recovery"))
              (emergency-test--wait (lambda () notice-end))
              (unless (equal notice-engine ordinary-engine) (error "Notification engine changed"))
              (princ (format "Emergency recovery %.3f ms; concurrent notification submit/source/end %.3f/%.3f/%.3f ms\n"
                             (* 1000 (- recovery-end start)) (* 1000 (- notice-submit start))
                             (* 1000 (- notice-first start)) (* 1000 (- notice-end start)))))
            (let ((speech (emergency-test--speech "espeak")))
              (princ (format "Retirement request/confirmed %.3f/%.3f ms; retirement-request to first requested source %.3f ms (blackout upper bound, not acoustic)\n"
                             (* 1000 (- retire-start start)) (* 1000 (- retire-end start))
                             (* 1000 (- (plist-get speech :first) retire-start)))))
            (unless (and (eq peer tts-notify-process) (process-live-p peer)
                         (eq peer-registration (process-get peer omnivox--choice-registration-property)))
              (error "Emergency recovery changed its healthy peer"))
            (let ((tts-speaker-process peer)) (emergency-test--speech ordinary-engine))
            (unless (equal before (emergency-test--fingerprints root))
              (error "Emergency modified blocked management records"))
            (unless windows
              (let ((old tts-speaker-process))
                (with-temp-buffer
                  (unless (zerop
                           (call-process "python3" nil t nil
                                         (expand-file-name "kill-worker.py" (getenv "OMNIVOX_TEST_FIXTURE_DIR"))
                                         (number-to-string (process-id old)) (getenv "OMNIVOX_PROGRAM")))
                    (error "Emergency worker crash injection failed: %s" (buffer-string)))
                  (princ (buffer-string)))
                (emergency-test--wait (lambda () (process-get old 'omnivox-library-retired)))
                (tts-letter "A")
                (unless (and (not (eq old tts-speaker-process))
                             (process-get tts-speaker-process 'omnivox-emergency-output))
                  (error "First character failed to restore minimal speech"))
                (emergency-test--speech "espeak")
                (princ "PASS: first character recovers a crashed emergency worker in minimal mode\n")))
            (dotimes (_ 3)
              (tts-recover)
              (emergency-test--speech "espeak"))
            (unless (equal before (emergency-test--fingerprints root))
              (error "Repeated minimal recovery changed management records"))
            (princ "PASS: lost reply, failed durable write, malformed preferences/host, minimal restart, peer and claims preserved\n"))))
    (dolist (process (delete-dups (list tts-speaker-process tts-notify-process)))
      (when (process-live-p process)
        (condition-case err (omnivox-library--retire-for-emergency process)
          (error (princ (format "Cleanup failed: %S\n" err))))))
    (when (and (not windows) (file-directory-p sessions)) (set-file-modes sessions #o700))))
