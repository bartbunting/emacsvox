(ert-deftest omnivox-recovery-guard-descriptors-require-exact-local-transports ()
  (omnivox-recovery-tests--workers
    (let ((omnivox-native-guard--owners nil)
          (id "01234567-89ab-cdef-0123-456789abcdef") connected)
      (cl-letf (((symbol-function 'omnivox-native-guard--connect)
                 (lambda (process) (push process connected))))
        (dolist (transport '("linux-abstract" "windows-pipe"))
          (let ((endpoint (list :version 1 :worker "worker" :guard id
                                :token (make-string 64 ?a) :transport transport
                                :address (concat (if (equal transport "windows-pipe")
                                                     "\\\\.\\pipe\\omnivox-guard-"
                                                   "omnivox-guard-") id))))
            (omnivox-native-guard--attach main (list :worker "worker" :guard endpoint))
            (should (equal (process-get main 'omnivox-native-guard-endpoint) endpoint))
            (setf (plist-get endpoint :address) (concat "remote-" (plist-get endpoint :address)))
            (should-error (omnivox-native-guard--attach main (list :worker "worker" :guard endpoint)))))
        (should (= 2 (length connected)))
        (should (equal omnivox-native-guard--owners (list main)))))))

(ert-deftest omnivox-emergency-prepares-bridge-while-old-speech-remains-usable ()
  (omnivox-recovery-tests--workers
    (let ((bridge (make-pipe-process :name "prepared bridge" :noquery t))
          (omnivox-native-guard--enabled t) (omnivox-native-guard--owners nil)
          (id "01234567-89ab-cdef-0123-456789abcdef") events)
      (unwind-protect
          (cl-letf (((symbol-function 'tts-queue--create) (lambda (create _) (funcall create)))
                    ((symbol-function 'tts--diagnostic-buffer) (lambda (&rest _) nil))
                    ((symbol-function 'make-process)
                     (lambda (&rest args)
                       (if (member "--native-guard-control" (plist-get args :command))
                           (progn (push 'bridge events) bridge)
                         (push 'owner events) replacement)))
                    ((symbol-function 'omnivox-library--owner)
                     (lambda (p)
                       (should (eq p replacement))
                       (should (eq (process-get p 'omnivox-native-guard-prepared-bridge) bridge))
                       (should-not (process-get p 'omnivox-native-guard-endpoint))
                       (should (tts--speech-process-usable-p main))
                       (should (tts--speech-process-usable-p notify))
                       (push 'describe events)
                       (list :worker "worker" :deferred_start_version 1 :emergency t
                             :prepared t :retired :false
                             :guard (list :version 1 :worker "worker" :guard id
                                          :token (make-string 64 ?a) :transport "linux-abstract"
                                          :address (concat "omnivox-guard-" id)))))
                    ((symbol-function 'process-send-string)
                     (lambda (p _) (should (eq p bridge)) (push 'descriptor events)))
                    ((symbol-function 'omnivox-native-guard--request)
                     (lambda (p command)
                       (should (eq (process-get p 'omnivox-native-guard) bridge))
                       (should (equal command "attach")) (push 'attach events))))
            (should (eq (omnivox-library--prepare-emergency "/private/omnivox" "null") replacement))
            (should (equal (reverse events) '(owner bridge describe descriptor attach)))
            (should-not (process-get replacement 'omnivox-native-guard-prepared-bridge))
            (should-not (process-get replacement 'omnivox-library-retired))
            (should (equal omnivox-native-guard--owners (list replacement))))
        (when (process-live-p bridge) (delete-process bridge))))))

(ert-deftest omnivox-emergency-failed-preparation-closes-unused-bridge ()
  (dolist (failure '(rejected quit))
    (omnivox-recovery-tests--workers
      (let ((bridge (make-pipe-process :name "unused bridge" :noquery t))
            (omnivox-native-guard--enabled t) (omnivox-native-guard--owners nil))
        (unwind-protect
            (cl-letf (((symbol-function 'tts-queue--create) (lambda (&rest _) replacement))
                      ((symbol-function 'omnivox-native-guard--start-bridge) (lambda (_) bridge))
                      ((symbol-function 'omnivox-library--owner)
                       (lambda (_) (if (eq failure 'quit) (signal 'quit nil) '(:prepared :false))))
                      ((symbol-function 'tts--retire-process) #'delete-process))
              (should (eq (condition-case err
                              (omnivox-library--prepare-emergency "/private/omnivox" "null")
                            ((error quit) (car err)))
                          (if (eq failure 'quit) 'quit 'error)))
              (should-not (process-live-p bridge))
              (should-not (process-live-p replacement))
              (should-not omnivox-library--emergency-pending)
              (should-not omnivox-native-guard--owners)
              (should (tts--speech-process-usable-p main))
              (should (tts--speech-process-usable-p notify)))
          (when (process-live-p bridge) (delete-process bridge)))))))

