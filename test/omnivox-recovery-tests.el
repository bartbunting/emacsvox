(require 'ert)
(require 'cl-lib)
(require 'tts-speak)
(require 'omnivox-library-runtime)
(require 'omnivox-voices)

(defmacro omnivox-recovery-tests--workers (&rest body)
  (declare (indent 0))
  `(let ((main (make-pipe-process :name "recovery main" :noquery t))
         (notify (make-pipe-process :name "recovery notify" :noquery t))
         (replacement (make-pipe-process :name "recovery replacement" :noquery t)))
     (unwind-protect
         (let ((tts-speaker-process main) (tts-notify-process notify) (tts-quiet nil)) ,@body)
       (dolist (p (list main notify replacement)) (when (process-live-p p) (delete-process p))))))

(ert-deftest omnivox-recovery-retired-native-owner-does-not-mask-worker-failure ()
  (omnivox-recovery-tests--workers
    (should (tts--speech-process-usable-p main))
    (process-put main 'omnivox-library-retired t)
    (process-put notify 'omnivox-library-retired t)
    (should (process-live-p main))
    (should-not (tts--speech-process-usable-p main))
    (should (eq (tts-notify-process) main))
    (let (letters recovered)
      (cl-letf (((symbol-function 'tts--recover-speaker)
                 (lambda () (setq recovered t tts-speaker-process replacement)))
                ((symbol-function 'tts--protocol-sync-capitalization-presentation) #'ignore)
                ((symbol-function 'tts--protocol-set-character-scale) #'ignore)
                ((symbol-function 'tts--protocol-letter)
                 (lambda (letter) (push (cons tts-speaker-process letter) letters))))
        (tts-letter "A"))
      (should recovered)
      (should (equal letters (list (cons replacement "A")))))))

(ert-deftest omnivox-recovery-explicit-repair-requires-native-retirement ()
  (omnivox-recovery-tests--workers
    (let (events)
      (cl-letf (((symbol-function 'process-command) (lambda (_) '("omnivox" "--voice-library-owner")))
                ((symbol-function 'omnivox-library--retire)
                 (lambda (p) (should (eq p main))
                   (should (= omnivox-library--timeout 6)) (push 'retired events)
                   (process-put p 'omnivox-library-retired t) (delete-process p)))
                ((symbol-function 'tts--recover-speaker)
                 (lambda () (should-not (process-live-p main))
                   (push 'recovered events) (setq tts-speaker-process replacement)))
                ((symbol-function 'tts--protocol-sync) (lambda () (push 'synchronized events))))
        (tts-recover))
      (should (equal (reverse events) '(retired recovered synchronized)))
      (should (eq tts-notify-process notify))
      (should (process-live-p notify)))))

(ert-deftest omnivox-recovery-unconfirmed-cleanup-never-starts-replacement ()
  (omnivox-recovery-tests--workers
    (cl-letf (((symbol-function 'process-command) (lambda (_) '("omnivox" "--voice-library-owner")))
              ((symbol-function 'omnivox-library--retire) (lambda (_) (error "cleanup unconfirmed")))
              ((symbol-function 'tts--recover-speaker) (lambda () (ert-fail "Unsafe replacement"))))
      (should-error (tts-recover))
      (should (process-live-p main))
      (delete-process main)
      (should-error (tts-recover) :type 'user-error))))

(ert-deftest omnivox-recovery-startup-registration-does-not-reconfigure-its-peer ()
  (omnivox-recovery-tests--workers
    (process-put notify omnivox--control-capabilities-property
                 '(:features ("logical_voice_registration")))
    (let (targets)
      (cl-letf (((symbol-function 'omnivox--register-logical-voices)
                 (lambda (processes) (setq targets processes)))
                ((symbol-function 'omnivox-register-logical-voices)
                 (lambda () (ert-fail "Startup reconfigured the healthy peer")))
                ((symbol-function 'run-hooks) #'ignore))
        (omnivox--handle-inventory-response notify '(:type "inventory" :engines [])))
      (should (equal targets (list notify))))))

(ert-deftest omnivox-recovery-readiness-waits-only-for-own-speech-initialization ()
  (omnivox-recovery-tests--workers
    (process-put main omnivox--control-capabilities-property '(:features ()))
    (let ((own (omnivox--pending-requests main)) (peer (omnivox--pending-requests notify)))
      (puthash 1 (omnivox--make-control-request :type "register_logical_voices_v3") own)
      (puthash 2 (omnivox--make-control-request :type "get_engine_parameters_v1") own)
      (puthash 3 (omnivox--make-control-request :type "register_logical_voices_v3") peer)
      (cl-letf (((symbol-function 'omnivox-library--wait)
                 (lambda (predicate process _description seconds)
                   (should (eq process main)) (should (= seconds 2))
                   (should-not (funcall predicate))
                   (remhash 1 own)
                   (should (funcall predicate)))))
        (omnivox-library--wait-for-recovered-speech main)))))

(ert-deftest omnivox-recovery-notification-fallback-retains-the-real-foreground-owner ()
  (omnivox-recovery-tests--workers
    (process-put notify 'omnivox-library-retired t)
    (tts-notify-apply (lambda (_) (setq tts-speaker-process replacement)) "notice")
    (should (eq tts-speaker-process replacement))))

(ert-deftest omnivox-recovery-notification-race-does-not-create-an-unreachable-owner ()
  (omnivox-recovery-tests--workers
    (let (selected)
      (cl-letf (((symbol-function 'tts-make-process)
                 (lambda (&rest _) (ert-fail "Notification created an unretained owner"))))
        (tts-notify-apply
         (lambda (_)
           (process-put notify 'omnivox-library-retired t)
           (tts--recover-speaker)
           (setq selected tts-speaker-process)) "notice"))
      (should (eq selected main))
      (should (eq tts-speaker-process main)))))

(ert-deftest omnivox-recovery-automatic-path-cannot-bypass-missing-native-cleanup ()
  (omnivox-recovery-tests--workers
    (delete-process main)
    (cl-letf (((symbol-function 'process-command)
               (lambda (_) '("omnivox" "--voice-library-owner")))
              ((symbol-function 'omnivox-remote-enabled-p) (lambda () nil))
              ((symbol-function 'tts-make-process)
               (lambda (&rest _) (ert-fail "Unconfirmed native owner was replaced"))))
      (should-error (tts--recover-speaker) :type 'user-error))))

(ert-deftest omnivox-recovery-sentinel-retains-unconfirmed-native-owner ()
  (omnivox-recovery-tests--workers
    (delete-process main)
    (cl-letf (((symbol-function 'process-command)
               (lambda (_) '("omnivox" "--voice-library-owner")))
              ((symbol-function 'tts--speech-process-terminal-p) (lambda (_) t))
              ((symbol-function 'omnivox-library--prepare-engines)
               (lambda () (ert-fail "Fresh restart bypassed missing cleanup"))))
      (tts--speech-process-sentinel main "finished")
      (should (eq tts-speaker-process main))
      (should-error (tts-recover) :type 'user-error)
      (should-error (tts-initialize) :type 'user-error)
      (should (eq (tts-notify-process) notify)))))

(ert-deftest omnivox-recovery-reconciliation-binds-old-launch-and-exact-receipt ()
  (dolist (case '(valid unsupported wrong-worker wrong-digest missing))
    (omnivox-recovery-tests--workers
      (let ((worker "11111111-1111-4111-8111-111111111111")
            (digest (make-string 64 ?a))
            (original-directory default-directory)
            (process-environment '("NEW_TARGET=must-not-be-used"))
            (service (make-pipe-process :name "receipt service" :noquery t))
            calls)
        (process-put main 'omnivox-library-launch-context
                     (list :program "/original/launcher" :directory original-directory
                           :environment '("ORIGINAL_TARGET=retained")))
        (process-put main 'omnivox-library-owner
                     (list :worker worker :startup "/original/host/sessions/owner.json"
                           :startup_sha256 digest))
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (should (equal (plist-get args :command)
                                    '("/original/launcher" "--voice-library-service")))
                     (should (equal process-environment '("ORIGINAL_TARGET=retained")))
                     (should (equal default-directory original-directory))
                     service))
                  ((symbol-function 'omnivox-library--request)
                   (lambda (p command &optional _owner)
                     (should (eq p service))
                     (should (= omnivox-library--timeout 2))
                     (push command calls)
                     (if (equal (plist-get command :command) "host")
                         (if (eq case 'unsupported) '(:type "host")
                           '(:type "host" :retirement_receipts_version 1))
                       (should (equal (plist-get command :worker) worker))
                       (should (equal (plist-get command :startup_sha256) digest))
                       (list :type "retirement_status"
                             :worker (if (eq case 'wrong-worker) "different" worker)
                             :startup_sha256 (if (eq case 'wrong-digest) "different" digest)
                             :retired (if (eq case 'missing) :false t))))))
          (if (eq case 'valid)
              (progn (omnivox-library--reconcile-retirement main)
                     (should (process-get main 'omnivox-library-retired)))
            (should-error (omnivox-library--reconcile-retirement main))
            (should-not (process-get main 'omnivox-library-retired))))
        (should (= (length calls) (if (eq case 'unsupported) 1 2)))
        (should-not (process-live-p service))))))

(ert-deftest omnivox-recovery-lost-final-reply-requires-persisted-native-proof ()
  (omnivox-recovery-tests--workers
    (let (verified)
      (cl-letf (((symbol-function 'process-command)
                 (lambda (_) '("omnivox" "--voice-library-owner")))
                ((symbol-function 'omnivox-library--retire)
                 (lambda (p) (delete-process p) (error "reply lost")))
                ((symbol-function 'omnivox-library--reconcile-retirement)
                 (lambda (p)
                   (should-not (process-live-p p))
                   (process-put p 'omnivox-library-retired t)
                   (setq verified t)))
                ((symbol-function 'tts--recover-speaker)
                 (lambda () (should verified) (setq tts-speaker-process replacement)))
                ((symbol-function 'tts--protocol-sync) #'ignore))
        (tts-recover))
      (should (eq tts-speaker-process replacement))
      (should (eq tts-notify-process notify)))))

(ert-deftest omnivox-emergency-unavailable-capability-preserves-working-main ()
  (omnivox-recovery-tests--workers
    (let ((tts-program "omnivox"))
      (cl-letf (((symbol-function 'tts--resolve-program) (lambda (_) "/test/omnivox"))
                ((symbol-function 'omnivox-remote-enabled-p) (lambda () nil))
                ((symbol-function 'omnivox-library--emergency-supported)
                 (lambda (_) (error "unsupported")))
                ((symbol-function 'omnivox-library--retire-for-emergency)
                 (lambda (_) (ert-fail "Capability failure retired working speech"))))
        (should-error (tts-emergency-start "null")))
      (should (eq tts-speaker-process main))
      (should (process-live-p main)))))

(ert-deftest omnivox-emergency-missing-native-proof-prevents-replacement ()
  (omnivox-recovery-tests--workers
    (let ((tts-program "omnivox"))
      (cl-letf (((symbol-function 'tts--resolve-program) (lambda (_) "/test/omnivox"))
                ((symbol-function 'omnivox-remote-enabled-p) (lambda () nil))
                ((symbol-function 'omnivox-library--emergency-supported) #'ignore)
                ((symbol-function 'omnivox-library--retire-for-emergency)
                 (lambda (_) (error "native cleanup is unconfirmed")))
                ((symbol-function 'tts-make-process)
                 (lambda (_) (ert-fail "Started over uncertain old speech"))))
        (should-error (tts-emergency-start "null")))
      (should (eq tts-speaker-process main))
      (should (eq tts-notify-process notify)))))

(ert-deftest omnivox-emergency-live-native-proof-does-not-need-a-durable-receipt ()
  (omnivox-recovery-tests--workers
    (process-put main 'omnivox-library-owner '(:worker "test-worker" :native_retirement_version 1))
    (let (requests)
      (cl-letf (((symbol-function 'process-command) (lambda (_) '("omnivox" "--voice-library-owner")))
                ((symbol-function 'omnivox-library--request)
                 (lambda (process command &optional owner)
                   (should (eq process main)) (should owner)
                   (push command requests)
                   (list :type "native_retired" :worker "test-worker" :retirement_recorded :false)))
                ((symbol-function 'tts--retire-process)
                 (lambda (process) (should (process-get process 'omnivox-library-retired))
                   (delete-process process))))
        (omnivox-library--retire-for-emergency main))
      (should (= 1 (length requests)))
      (should (process-live-p notify))
      (should (process-get main 'omnivox-library-retired)))))

(ert-deftest omnivox-emergency-lost-reply-queries-the-same-live-native-authority ()
  (omnivox-recovery-tests--workers
    (process-put main 'omnivox-library-owner '(:worker "test-worker" :native_retirement_version 1))
    (let ((requests 0))
      (cl-letf (((symbol-function 'process-command) (lambda (_) '("omnivox" "--voice-library-owner")))
                ((symbol-function 'omnivox-library--request)
                 (lambda (process command &optional _owner)
                   (should (eq process main))
                   (should (equal (plist-get command :command) "retire-native"))
                   (if (= (cl-incf requests) 1) (error "lost reply")
                     '(:type "native_retired" :worker "test-worker" :retirement_recorded :false))))
                ((symbol-function 'tts--retire-process) #'delete-process))
        (omnivox-library--retire-for-emergency main))
      (should (= requests 2))
      (should (process-live-p notify)))))

(ert-deftest omnivox-emergency-failed-start-retains-unconfirmed-native-attempt ()
  (omnivox-recovery-tests--workers
    (let ((tts-program "omnivox") (attempts 0))
      (cl-letf (((symbol-function 'tts--resolve-program) (lambda (_) "/test/omnivox"))
                ((symbol-function 'omnivox-remote-enabled-p) (lambda () nil))
                ((symbol-function 'omnivox-library--emergency-supported) #'ignore)
                ((symbol-function 'omnivox-library--retire-for-emergency)
                 (lambda (p) (when (eq p replacement) (error "native cleanup unconfirmed"))))
                ((symbol-function 'tts-make-process)
                 (lambda (_)
                   (cl-incf attempts)
                   (funcall omnivox-library--birth-collector replacement)
                   (error "initialization failed"))))
        (should-error (tts-emergency-start "null"))
        (should (eq tts-speaker-process replacement))
        (should (process-live-p replacement))
        (should-error (tts-emergency-start "null"))
        (should (= attempts 1))
        (should (eq tts-notify-process notify))))))

(ert-deftest omnivox-emergency-cannot-race-an-active-management-replacement ()
  (omnivox-recovery-tests--workers
    (let ((tts-program "omnivox") (omnivox-library--busy t))
      (cl-letf (((symbol-function 'omnivox-remote-enabled-p) (lambda () nil))
                ((symbol-function 'tts-make-process) (lambda (_) (ert-fail "Raced managed native creation"))))
        (should-error (tts-emergency-start "null") :type 'user-error)
        (should (eq tts-speaker-process main))
        (should (process-live-p main))))))

