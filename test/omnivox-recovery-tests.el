(ert-deftest omnivox-recovery-reconciliation-binds-old-launch-and-exact-receipt ()
  (dolist (case '(valid unsupported wrong-worker wrong-digest missing))
    (omnivox-recovery-tests--workers
      (let ((worker "11111111-1111-4111-8111-111111111111")
            (digest (make-string 64 ?a))
            (original-directory default-directory)
            (process-environment '("NEW_TARGET=must-not-be-used"))
            (service (make-pipe-process :name "receipt service" :noquery t))
            calls)
        (process-put main 'omnivox-library-launch-context
                     (list :program "/original/launcher" :directory original-directory
                           :environment '("ORIGINAL_TARGET=retained")))
        (process-put main 'omnivox-library-owner
                     (list :worker worker :startup "/original/host/sessions/owner.json"
                           :startup_sha256 digest))
        (cl-letf (((symbol-function 'make-process)
                   (lambda (&rest args)
                     (should (equal (plist-get args :command)
                                    '("/original/launcher" "--voice-library-service")))
                     (should (equal process-environment '("ORIGINAL_TARGET=retained")))
                     (should (equal default-directory original-directory))
                     service))
                  ((symbol-function 'omnivox-library--request)
                   (lambda (p command &optional _owner)
                     (should (eq p service))
                     (should (= omnivox-library--timeout 2))
                     (push command calls)
                     (if (equal (plist-get command :command) "host")
                         (if (eq case 'unsupported) '(:type "host")
                           '(:type "host" :retirement_receipts_version 1))
                       (should (equal (plist-get command :worker) worker))
                       (should (equal (plist-get command :startup_sha256) digest))
                       (list :type "retirement_status"
                             :worker (if (eq case 'wrong-worker) "different" worker)
                             :startup_sha256 (if (eq case 'wrong-digest) "different" digest)
                             :retired (if (eq case 'missing) :false t))))))
          (if (eq case 'valid)
              (progn (omnivox-library--reconcile-retirement main)
                     (should (process-get main 'omnivox-library-retired)))
            (should-error (omnivox-library--reconcile-retirement main))
            (should-not (process-get main 'omnivox-library-retired))))
        (should (= (length calls) (if (eq case 'unsupported) 1 2)))
        (should-not (process-live-p service))))))

