(ert-deftest omnivox-recovery-dead-prepared-bridge-is-replaced-once ()
  (omnivox-recovery-tests--workers
    (delete-process replacement)
    (process-put main 'omnivox-native-guard-prepared-bridge replacement)
    (process-put main 'omnivox-native-guard-endpoint '(:guard "retained" :worker "worker"))
    (let ((starts 0))
      (cl-letf (((symbol-function 'omnivox-native-guard--start-bridge)
                 (lambda (_) (cl-incf starts) notify))
                ((symbol-function 'process-send-string) #'ignore)
                ((symbol-function 'omnivox-native-guard--request) #'ignore))
        (omnivox-native-guard--connect main))
      (should (= starts 1))
      (should (eq (process-get main 'omnivox-native-guard) notify))
      (should-not (process-get main 'omnivox-native-guard-prepared-bridge))
      (should-not (process-get main 'omnivox-native-guard-proof)))))

(ert-deftest omnivox-recovery-ordinary-start-prepares-and-cleans-unused-bridge ()
  (dolist (failure '(error quit))
    (omnivox-recovery-tests--workers
      (let ((bridge (make-pipe-process :name "ordinary bridge" :noquery t))
            (omnivox--emergency-prepared-process replacement)
            (omnivox-library--birth-collector nil) events)
        (tts-queue--attach replacement nil t)
        (unwind-protect
            (cl-letf (((symbol-function 'tts--resolve-program) (lambda (_) "/private/omnivox"))
                      ((symbol-function 'omnivox-remote-enabled-p) (lambda () nil))
                      ((symbol-function 'process-command)
                       (lambda (_) '("omnivox" "--voice-library-owner" "--guarded")))
                      ((symbol-function 'omnivox-native-guard--start-bridge)
                       (lambda (p) (should (eq p replacement)) (push 'bridge events) bridge))
                      ((symbol-function 'omnivox-library--owner)
                       (lambda (p)
                         (should (eq (process-get p 'omnivox-native-guard-prepared-bridge) bridge))
                         (should-not (process-get p 'omnivox-native-guard-endpoint))
                         (push 'describe events)
                         (signal failure '("fixture preparation failed"))))
                      ((symbol-function 'tts--retire-process) #'delete-process))
              (should (eq (condition-case err (tts-make-process "Speaker")
                            ((error quit) (car err))) failure))
              (should (equal (reverse events) '(bridge describe)))
              (should-not (process-live-p bridge))
              (should-not (process-live-p replacement))
              (should (process-live-p main))
              (should (process-live-p notify)))
          (when (process-live-p bridge) (delete-process bridge)))))))

