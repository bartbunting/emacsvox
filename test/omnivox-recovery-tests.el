(ert-deftest omnivox-emergency-reuses-prepared-owner-only-after-old-retirement ()
  (omnivox-recovery-tests--workers
    (let ((tts-program "omnivox") events)
      (cl-letf (((symbol-function 'tts--resolve-program) (lambda (_) "/test/omnivox"))
                ((symbol-function 'omnivox-remote-enabled-p) (lambda () nil))
                ((symbol-function 'omnivox-library--prepare-emergency)
                 (lambda (_program output)
                   (should (equal output "null"))
                   (should (eq tts-speaker-process main))
                   (should (process-live-p main))
                   (should omnivox-library--busy)
                   (should-error (tts-emergency-start "null") :type 'user-error)
                   (push 'prepared events) replacement))
                ((symbol-function 'omnivox-library--retire-for-emergency)
                 (lambda (p) (should (eq p main)) (push 'retired events)))
                ((symbol-function 'omnivox-library--release-emergency)
                 (lambda (p) (should (eq p replacement)) (push 'released events)))
                ((symbol-function 'tts-make-process)
                 (lambda (_) (should (eq omnivox--emergency-prepared-process replacement))
                   (push 'configured events) replacement))
                ((symbol-function 'voice-setup) #'ignore)
                ((symbol-function 'omnivox-library--wait-for-recovered-speech)
                 (lambda (_) (push 'ready events))))
        (tts-emergency-start "null"))
      (should (equal (reverse events) '(prepared retired released configured ready)))
      (should (eq tts-speaker-process replacement))
      (should (eq tts-notify-process notify)))))

