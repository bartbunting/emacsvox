;; Run in a fresh native Windows Emacs with an isolated OMNIVOX_NATIVE_TEST_ROOT.
;; The caller creates its native-reload-test marker and selected config.json.
(require 'cl-lib)
(require 'json)
(require 'subr-x)

(defvar native-reload--root (getenv "OMNIVOX_NATIVE_TEST_ROOT"))
(defvar native-reload--observations nil)

(defun native-reload--wait (predicate description)
  (let ((deadline (+ (float-time) 30)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil .01))
    (unless (funcall predicate) (error "Timed out: %s" description))))

(defun native-reload--record (step &rest fields)
  (push (append (list :step step) fields) native-reload--observations)
  (princ (format "PASS %s\n" step)))

(defun native-reload--diagnostics ()
  (with-temp-file (expand-file-name "diagnostics.txt" native-reload--root)
    (dolist (buffer (buffer-list))
      (when (or (equal (buffer-name buffer) "*Messages*")
                (string-match-p "diagnostics" (buffer-name buffer)))
        (insert "\n" (buffer-name buffer) "\n")
        (insert (with-current-buffer buffer
                  (buffer-substring-no-properties (max (point-min) (- (point-max) 16000))
                                                  (point-max))))))))

(defun native-reload--speech (process expected)
  (native-reload--wait
   (lambda () (condition-case nil (omnivox--choice-current-registration process) (error nil)))
   "voice registration")
  (let ((tts-speaker-process process) completed engine events)
    (tts-speak-marked
     "Native Windows speech continues during the settings check."
     (lambda (_ event)
       (push event events)
       (when (equal (plist-get event :type) "utterance_started")
         (setq engine (plist-get event :engine_id))))
     (lambda (_ status) (setq completed status)))
    (native-reload--wait (lambda () completed) "source speech completion")
    (unless (and (eq completed 'completed) (equal expected engine))
      (error "Speech failed: %S %S, expected %s; events: %S"
             completed engine expected (nreverse events)))))

(defun native-reload--state (process)
  (let ((state (omnivox-library--control process '(:type "host_preferences_status_v1"))))
    (unless (omnivox-preferences--state-p state) (error "Invalid live preference state"))
    state))

(defun native-reload--save (words)
  (let* ((path (expand-file-name "config.json" native-reload--root))
         (config (with-temp-buffer
                   (insert-file-contents path)
                   (json-parse-buffer :object-type 'hash-table :array-type 'array
                                      :null-object :null :false-object :false)))
         (speech (or (gethash "speech" config) (make-hash-table :test #'equal))))
    (puthash "max_chunk_words" words speech)
    (puthash "speech" speech config)
    (with-temp-file (concat path ".new")
      (insert (json-serialize config :null-object :null :false-object :false)))
    (rename-file (concat path ".new") path t)))

(defun native-reload--reload (expected)
  (let (results)
    (omnivox-reload-preferences (lambda (value) (setq results value)))
    ;; Exercise both existing lanes while the saved policy is being prepared.
    (tts-letter ?A)
    (native-reload--wait (lambda () results) "host preference reload")
    (let ((outcomes (mapcar (lambda (role)
                              (plist-get (cl-find role results :key
                                                  (lambda (r) (plist-get r :role))
                                                  :test #'equal)
                                         :outcome))
                            '("Main" "Notifications"))))
      (unless (equal outcomes expected) (error "Unexpected reload results: %S" outcomes))
      outcomes)))

(unless (and (eq system-type 'windows-nt) native-reload--root
             (file-exists-p (expand-file-name "native-reload-test" native-reload--root))
             (equal (expand-file-name native-reload--root)
                    (expand-file-name (or (getenv "OMNIVOX_CONFIG_DIR") ""))))
  (error "An explicit isolated native Windows test directory is required"))

(let* ((source (file-name-as-directory (getenv "EMACSVOX_DIR")))
       (expected (getenv "OMNIVOX_ENGINE")) failure)
  (setq user-emacs-directory (expand-file-name "profile/" native-reload--root)
        custom-file (expand-file-name "custom.el" user-emacs-directory)
        emacsvox-user-directory (expand-file-name "resources" native-reload--root)
        omnivox-native-guard--enabled t tts-notification-device "both"
        emacsvox-speak-messages nil load-prefer-newer nil)
  (add-to-list 'load-path (expand-file-name "lisp" source))
  (require 'emacsvox-preamble)
  (load (expand-file-name "lisp/emacsvox-setup.el" source) nil nil t)
  (require 'omnivox-preferences)
  (require 'omnivox-punctuation)
  (unless (and (file-in-directory-p (symbol-file 'omnivox-library--local-target-p 'defun) source)
               (string-suffix-p ".elc" (symbol-file 'omnivox-library--local-target-p 'defun)))
    (error "Expected the compiled candidate client"))
  (unwind-protect
      (condition-case err
          (progn
            (tts-initialize)
            (dolist (process (list tts-speaker-process tts-notify-process))
              (unless (and (omnivox-library--owned-p process)
                           (process-live-p (process-get process 'omnivox-native-guard))
                           (equal "windows-pipe" (plist-get (process-get process 'omnivox-native-guard-endpoint) :transport)))
                (error "Missing native Windows owner/guard"))
              (native-reload--speech process expected))
            (native-reload--record "two guarded lanes" :engine expected)
            (unless (stringp (plist-get (omnivox-punctuation--request '(:command "punctuation-review")) :path))
              (error "Native settings service did not return its selected configuration"))
            (let* ((main tts-speaker-process) (notify tts-notify-process)
                   (before (native-reload--state main))
                   (owner (process-get main 'omnivox-library-owner)))
              (native-reload--save 12)
              (native-reload--reload '("applied" "applied"))
              (let ((after (native-reload--state main)))
                (unless (and (eq main tts-speaker-process) (eq notify tts-notify-process)
                             (equal owner (process-get main 'omnivox-library-owner))
                             (equal (plist-get before :incarnation) (plist-get after :incarnation))
                             (< (plist-get before :revision) (plist-get after :revision))
                             (not (equal (plist-get before :host_preferences_sha256)
                                         (plist-get after :host_preferences_sha256))))
                  (error "Reload did not install a new policy on the existing owner"))
                (native-reload--record "in-place policy installation" :revision (plist-get after :revision)))
              (native-reload--speech main expected)
              (native-reload--speech notify expected)
              (let* ((path (expand-file-name "config.json" native-reload--root))
                     (saved (with-temp-buffer (insert-file-contents path) (buffer-string)))
                     (state (native-reload--state main)))
                (unwind-protect
                    (progn
                      (with-temp-file path (insert "invalid saved configuration"))
                      (native-reload--reload '("rejected" "rejected"))
                      (unless (= (plist-get state :revision) (plist-get (native-reload--state main) :revision))
                        (error "Rejected settings changed the live policy"))
                      (native-reload--speech main expected)
                      (tts-recover)
                      (native-reload--speech tts-speaker-process expected)
                      (unless (eq notify tts-notify-process) (error "Retained recovery replaced the peer"))
                      (native-reload--record "malformed settings and retained recovery"))
                  (with-temp-file path (insert saved)))))
            (let* ((main tts-speaker-process) (notify tts-notify-process)
                   (endpoint (process-get main 'omnivox-native-guard-endpoint)))
              (delete-process (process-get main 'omnivox-native-guard))
              (let ((reply (omnivox-native-guard--request main "status")))
                (unless (equal (plist-get reply :guard) (plist-get endpoint :guard))
                  (error "Reconnect changed native authority")))
              (native-reload--record "same-guard control reconnection")
              ;; This is the exact process object spawned by this test, not a saved PID.
              (delete-process main)
              (tts-emergency-start "null")
              (native-reload--speech tts-speaker-process "espeak")
              (native-reload--speech notify expected)
              (unless (eq notify tts-notify-process) (error "Emergency recovery replaced the peer"))
              (native-reload--record "owner loss and guarded emergency recovery"))
            (tts-restart)
            (native-reload--speech tts-speaker-process expected)
            (native-reload--record "return to saved startup")
            (let ((main tts-speaker-process))
              (omnivox-library--retire-for-emergency tts-notify-process)
              (native-reload--save 13)
              (native-reload--reload '("applied" "unavailable"))
              (native-reload--speech main expected)
              (unless (eq main tts-speaker-process) (error "Peer loss replaced the main worker"))
              (native-reload--record "foreground reload with absent notifications")))
        (error (setq failure (error-message-string err))
               (native-reload--diagnostics)))
    (dolist (process (delete-dups (append (list tts-speaker-process tts-notify-process)
                                         omnivox-native-guard--owners)))
      (when (processp process)
        (condition-case err
            (omnivox-library--retire-for-emergency process)
          (error (setq failure (concat (or failure "") " Cleanup: " (error-message-string err))))))))
  (with-temp-file (expand-file-name "result.json" native-reload--root)
    (insert (json-serialize
             (list :result (if failure "failed" "passed") :error (or failure :null)
                   :emacs emacs-version :engine expected
                   :client (symbol-file 'omnivox-library--local-target-p 'defun)
                   :observations (vconcat (nreverse native-reload--observations)))
             :null-object :null)))
  (when failure (error "%s" failure)))
