;;; Commentary:
;; Opt-in fresh-batch acceptance. Set EMACSVOX_CHARACTER_TEST_SERVER to a staged
;; development Omnivox executable advertising the complete choice bundle.
;; It starts isolated eSpeak processes with --audio-output null. No installed
;; server or personal configuration is changed. Build byte-code first; set
;; EMACSVOX_CHARACTER_TEST_SOURCE=1 only when deliberately exercising source.

;;; Code:
(unless noninteractive (error "Run acceptance in a fresh batch Emacs"))
(require 'cl-lib)
(require 'ert)
(setq load-prefer-newer t)
(let* ((root (expand-file-name "../" (file-name-directory load-file-name)))
       (directory (expand-file-name "lisp/" root))
       (source (getenv "EMACSVOX_CHARACTER_TEST_SOURCE")))
  (add-to-list 'load-path directory)
  (add-to-list 'load-path (expand-file-name "test/" root))
  (load (expand-file-name "emacsvox-preamble.el" directory) nil t)
  (dolist (name '("tts-speak" "emacsvox-speak" "omnivox-choice-codec" "emacsvox-aural-transport" "omnivox-voices"
                 "emacsvox-aural-history" "emacsvox-aural-replay"))
    (load (expand-file-name (concat name (if source ".el" ".elc")) directory) nil t)))
(require 'omnivox-choice-playback-tests)
(require 'emacsvox-aural-replay)
(defun omnivox-character-acceptance--wait (predicate)
  (let ((deadline (+ (float-time) 20)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.02))
    (unless (funcall predicate) (error "Timed out waiting for muted client/server acceptance"))))
(defun omnivox-character-acceptance--control (process type)
  (let (answer)
    (omnivox--send-control-request process (list :type type) (lambda (_ response) (setq answer response)))
    (omnivox-character-acceptance--wait (lambda () answer))
    answer))
(defun omnivox-character-acceptance--process (name generation)
  (let ((process (make-process :name name :noquery t :connection-type 'pipe
                               :command (list (or (getenv "EMACSVOX_CHARACTER_TEST_SERVER") (error "Set EMACSVOX_CHARACTER_TEST_SERVER"))
                                              "--engine" "espeak" "--audio-output" "null")
                               :stderr (get-buffer-create " *choice-live-errors*")
                               :filter #'tts--speaker-process-filter)))
    (process-put process 'tts--speech-process-generation generation)
    (omnivox--install-control-filter process)
    (let ((capabilities (omnivox-character-acceptance--control process "capabilities")))
      (process-put process omnivox--control-capabilities-property capabilities)
      (unless (omnivox--choice-tuning-supported-p process) (error "Server lacks the complete choice bundle")))
    (process-put process omnivox--control-inventory-property (omnivox-character-acceptance--control process "inventory"))
    (process-put process tts--tracked-playback-completion-property t)
    (process-put process tts--marker-playback-events-property t)
    process))
(let* ((tts-program "omnivox") (tts-quiet nil)
       (tts-speaker-process (omnivox-character-acceptance--process "character-main" 3001))
       (tts-notify-process (omnivox-character-acceptance--process "character-notify" 3002))
       (omnivox--logical-registry-generation 0)
       (omnivox--logical-registry-signature nil)
       (omnivox-average-pitch-contrast 1.0)
       (omnivox-logical-voice-preferences nil) (omnivox-logical-voice-languages nil)
       (omnivox-engine-priority-ids nil) (omnivox-fallback-engine-ids nil)
       (omnivox-disabled-engine-ids nil) (omnivox-global-default-selector nil)
       (omnivox-last-realized-routes (make-hash-table :test #'equal))
       (omnivox-realized-route-changed-hook nil) (tts-realized-voice-changed-hook nil)
       (omnivox-initial-routing-ready-hook nil) (tts-stopped-hook nil)
       (emacsvox-speak-messages nil) (omnivox-marker-last-error nil)
       (emacsvox-aural-presentation-history nil)
       (emacsvox-aural-presentation-history-limit 20)
       (emacsvox-aural-history-record-interface-presentations t)
       (emacsvox-aural-submission-controls-interruption nil)
       (emacsvox-aural-submission-delivery-policy 'ordered)
       (emacsvox-delayed-phonetic-mode nil)
       (selector '(:kind exact :scope local :engine-id "espeak" :voice-id "espeak:gmw/en+max"))
       (owned (list :mode 'owned :name 'default :palette 'isolated-acceptance :names '(default)
                    :definition '(:average-pitch 4 :richness 5)
                    :choices (list (list :id "max" :selector selector :adjustments nil))
                    :selectors (list selector) :choice-source 'local :language nil)))
  (unwind-protect
      (cl-letf (((symbol-function 'omnivox--logical-voice-ids) (lambda () '("default")))
                ((symbol-function 'emacsvox-aural-voice-runtime--owned) (lambda (&rest _) owned))
                ((symbol-function 'tts-voice-reset-code) (lambda () "")))
        (dolist (process (list tts-speaker-process tts-notify-process))
          (unless (omnivox--process-supports-p process "palette_letter_v1")
            (error "Server lacks palette_letter_v1")))
        (let (applied)
          (omnivox-apply-voice-configuration (lambda (result) (setq applied result)))
          (omnivox-character-acceptance--wait (lambda () applied))
          (unless (eq (plist-get applied :status) 'applied)
            (error "Configuration failed: %S" applied)))
        (omnivox-character-acceptance--wait
         (lambda () (cl-every (lambda (process)
                               (eql omnivox--logical-registry-generation
                                    (plist-get (process-get process omnivox--choice-registration-property)
                                               :registry-generation)))
                             (list tts-speaker-process tts-notify-process))))
        (dolist (lane (list tts-speaker-process tts-notify-process))
          (let ((tts-speaker-process lane))
            (dolist (text '("q" "Q" "'"))
              (let* (result
                     (tts--tracked-completion-function (lambda (_ status) (setq result status))))
                (emacsvox-speak-this-char (aref text 0))
                (omnivox-character-acceptance--wait (lambda () result))
                (unless (eq result 'completed) (error "Character %S ended %S" text result))
                (let ((route (omnivox-last-realized-voice 'default)))
                  (unless (and (eq (plist-get route :choice-status) 'verified)
                               (equal (plist-get route :choice-id) "max")
                               (equal (plist-get route :voice-id) "espeak:gmw/en+max"))
                    (error "Unexpected character route: %S" route))
                  (princ (format "lane=%s character=%S actual=%s completed\n"
                                 (plist-get route :lane) text (plist-get route :voice-id))))
                (unless (= 0 (process-get lane 'tts--dispatch-metadata-bytes))
                  (error "Retained character metadata leaked"))))))
        ;; A burst must cancel retired generations and release every client owner.
        (let ((results (make-vector 12 nil)))
          (dotimes (index 12)
            (let ((tts--tracked-completion-function
                   (lambda (_ status)
                     (when (aref results index) (error "Duplicate terminal completion"))
                     (aset results index status))))
              (tts-letter "q")))
          (omnivox-character-acceptance--wait
           (lambda () (cl-every #'identity (append results nil))))
          (unless (and (eq (aref results 11) 'completed)
                       (cl-every (lambda (s) (memq s '(completed cancelled))) results))
            (error "Unexpected burst completions: %S" results))
          (princ (format "rapid-character-burst=%S\n" results)))
        (when omnivox-marker-last-error
          (error "Marker decoder rejected output: %S" omnivox-marker-last-error)))
    (dolist (process (list tts-speaker-process tts-notify-process))
      (when (process-live-p process) (tts--retire-process process)))))
(princ "Muted character palette acceptance passed.\n")
;;; verify-omnivox-character-runtime.el ends here
