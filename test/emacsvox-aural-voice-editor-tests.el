(ert-deftest emacsvox-aural-voice-editor-return-after-refresh-and-standard-actions ()
  (emacsvox-test--with-voice-editor
   (let ((origin (generate-new-buffer " *voice-editor-table*")) column)
     (unwind-protect
         (progn
           (switch-to-buffer origin)
           (emacsvox-aural-voice-palette-previews-mode)
           (setq emacsvox-aural-voice-palette-previews-palette 'reading-owned)
           (emacsvox-aural-voice-palette-previews-refresh)
           (emacsvox-aural-ui-goto-row 'bolden)
           (move-to-column 25)
           (setq column (current-column))
           (emacsvox-aural-voice-editor-open 'reading-owned 'bolden origin)
           (should (eq (key-binding (kbd "C-c C-i")) #'emacsvox-aural-ui-open-manual))
           (emacsvox-aural-voice-editor--locate 'more)
           (call-interactively (key-binding (kbd "RET")))
           (should (emacsvox-aural-voice-editor--get :effects))
           (emacsvox-aural-voice-editor--put :automatic-sample nil)
           (emacsvox-aural-voice-editor--set 'richness 8)
           (emacsvox-aural-voice-editor-save)
           (funcall (car callbacks) '(:status applied))
           (should (cl-some (lambda (text) (string-match-p "Saved and applied" text)) speech))
           (emacsvox-aural-voice-editor-leave)
           (should (eq (current-buffer) origin))
           (should (eq (tabulated-list-get-id) 'bolden))
           (should (= (current-column) column)))
       (kill-buffer origin)))))

(ert-deftest emacsvox-aural-voice-editor-adjustment-sample-starts-with-displayed-value ()
  (emacsvox-test--with-voice-editor
   (emacsvox-aural-voice-editor-experiment
    '((:engine-id "test") (:voice-id "one")) (current-buffer) "The quick brown fox.")
   (emacsvox-aural-voice-editor--locate 'average-pitch)
   (setq speech nil)
   (emacsvox-aural-voice-editor-increase)
   (should (equal (plist-get (caar requests) :text) "1. The quick brown fox."))
   (should-not speech)
   (emacsvox-aural-voice-editor-increase)
