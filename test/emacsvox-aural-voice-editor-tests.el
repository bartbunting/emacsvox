(ert-deftest emacsvox-aural-voice-editor-individual-keep-merges-working-draft-and-retains-retry ()
  (emacsvox-test--with-layered-editor
   (emacsvox-aural-voice-editor--set 'richness 7)
   (let* ((destination emacsvox-aural-voice-editor--context)
          (before (emacsvox-aural-voice-editor--working))
          (proposal (emacsvox-aural-voice-drafts--make-save :draft draft :state 'partial :completed '(local))))
     (setf (emacsvox-aural-voice-draft-proposal draft) proposal)
     (emacsvox-aural-voice-editor-experiment '((:engine-id "new") (:voice-id "new")) (current-buffer) "Sample")
     (emacsvox-aural-voice-editor--put :automatic-sample nil)
     (emacsvox-aural-voice-editor--set 'richness 2)
     (let ((origin emacsvox-aural-voice-editor--context))
       (cl-letf (((symbol-function 'completing-read)
                  (lambda (prompt collection &rest args)
                    (cond ((equal prompt "Destination palette: ") "reading-owned")
                          ((equal prompt "Use for named voice: ") "bolden")
                          ((equal prompt "Destination fallback: ") (car (nth 1 collection)))
                          ((equal prompt "Place physical voice: ") "Replace selected choice")
                          (t (nth 4 args))))))
         (emacsvox-aural-voice-editor-keep-experiment))
       (should (eq destination emacsvox-aural-voice-editor--context))
       (should (eq origin (emacsvox-aural-voice-editor--get :experiment)))
       (should (eq proposal (emacsvox-aural-voice-draft-proposal draft)))
       (should (eq (emacsvox-aural-voice-save-state proposal) 'partial))
       (let* ((after (emacsvox-aural-voice-editor--working)) (rows (plist-get after :choices)))
         (should (equal (plist-get before :definition) (plist-get after :definition)))
         (should (equal (car rows) (car (plist-get before :choices))))
         (should (equal (nth 2 rows) (nth 2 (plist-get before :choices))))
         (should (equal (plist-get (nth 1 rows) :id) "alternate"))
         (should (equal (plist-get (plist-get (nth 1 rows) :selector) :engine-id) "new"))
         (should (= (plist-get (plist-get (nth 1 rows) :adjustments) :richness) 2)))
       (emacsvox-aural-voice-editor-undo)
       (should (equal before (emacsvox-aural-voice-editor--working)))))))

(ert-deftest emacsvox-aural-voice-editor-experiment-keep-rejects-reentrant-input-changes ()
  (dolist (change '(origin destination cancel))
    (emacsvox-test--with-layered-editor
     (let ((destination draft) (before (emacsvox-aural-voice-editor--working)))
       (emacsvox-aural-voice-editor-experiment '((:engine-id "new") (:voice-id "new")) (current-buffer) "Sample")
       (emacsvox-aural-voice-editor--put :automatic-sample nil)
       (cl-letf (((symbol-function 'completing-read)
                  (lambda (prompt _collection &rest args)
                    (cond ((equal prompt "Destination palette: ") "reading-owned")
                          ((equal prompt "Use for named voice: ") "bolden")
                          ((equal prompt "Place physical voice: ")
                           (pcase change
                             ('origin (emacsvox-aural-voice-editor--set 'richness 2))
                             ('destination (emacsvox-aural-voice-drafts--edit destination (plist-put (copy-tree before) :language "fr")))
                             ('cancel (user-error "Cancelled")))
                           "Add as fallback")
                          (t (nth 4 args))))))
         (should-error (emacsvox-aural-voice-editor-keep-experiment)))
       (should (= (length (plist-get (emacsvox-aural-voice-draft-working destination) :choices)) 3))
       (unless (eq change 'destination) (should (equal before (emacsvox-aural-voice-draft-working destination))))))))

(ert-deftest emacsvox-aural-voice-editor-adjustment-keep-selects-a-row-and-retains-its-physical-voice ()
  (emacsvox-test--with-layered-editor
   ;; The wire fixture has sparse shared fields; saving requires a full ACSS base.
   (emacsvox-aural-voice-editor--set 'richness 9)
   (let ((before (emacsvox-aural-voice-editor--working)))
     (emacsvox-aural-voice-editor-experiment '((:engine-id "new") (:voice-id "new")) (current-buffer) "Sample")
     (emacsvox-aural-voice-editor--put :automatic-sample nil)
     (emacsvox-aural-voice-editor--set 'richness 2)
     (cl-letf (((symbol-function 'completing-read)
                (lambda (prompt collection &rest _)
                  (pcase prompt
                    ("Destination palette: " "reading-owned")
                    ("Use for named voice: " "bolden")
                    ("Keep from experiment: " "Adjustments only — selected choice")
                    ("Destination fallback: " (car (nth 2 collection)))
                    ("Destination has a draft: " "Add chosen changes to this draft")
                    (_ (error "Unexpected keep prompt: %s" prompt))))))
       (emacsvox-aural-voice-editor-keep-experiment))
     (let ((after (emacsvox-aural-voice-editor--working)))
       (should (equal (plist-get before :selectors) (plist-get after :selectors)))
       (should (equal (plist-get before :definition) (plist-get after :definition)))
       (should (= (plist-get (plist-get (nth 2 (plist-get after :choices)) :adjustments) :richness) 2)))
     (emacsvox-aural-voice-editor-save)
     (ert-info ((format "Save result: %S" (emacsvox-aural-voice-save-result
                                           (emacsvox-aural-voice-draft-proposal (emacsvox-aural-voice-editor--draft)))))
       (should (= (length callbacks) 1)))
     (funcall (car callbacks) '(:status applied))
     (should-not (emacsvox-aural-voice-drafts--dirty-fields (emacsvox-aural-voice-editor--draft)))
     (let* ((resolved (emacsvox-aural-voice-runtime--resolve 'bolden 'reading-owned))
            (patch (plist-get (nth 2 (plist-get resolved :choices)) :adjustments)))
       (should (= (plist-get patch :richness) 2))
       (should (plist-member patch :echo))
       (should-not (plist-get patch :echo))))))

(ert-deftest emacsvox-aural-voice-editor-physical-keep-requires-tuning-replacement-choice ()
  (dolist (replacement '(keep reset))
    (emacsvox-test--with-layered-editor
     (let ((before (emacsvox-aural-voice-editor--working)))
       (emacsvox-aural-voice-editor-experiment '((:engine-id "new") (:voice-id "new")) (current-buffer) "Sample")
       (cl-letf (((symbol-function 'completing-read)
                  (lambda (prompt collection &rest _)
                    (cond ((equal prompt "Destination palette: ") "reading-owned")
                          ((equal prompt "Use for named voice: ") "bolden")
                          ((equal prompt "Keep from experiment: ") "Physical voice only")
                          ((equal prompt "Place physical voice: ") "Replace selected choice")
                          ((equal prompt "Destination fallback: ") (car (nth 1 collection)))
                          ((string-prefix-p "New physical voice" prompt)
                           (if (eq replacement 'keep) "Keep this row's custom settings" "Use shared settings"))
                          (t (error "Unexpected prompt: %s" prompt))))))
         (emacsvox-aural-voice-editor-keep-experiment))
       (let* ((after (emacsvox-aural-voice-editor--working)) (row (nth 1 (plist-get after :choices))))
         (should (equal (plist-get row :id) "alternate"))
         (should (equal (plist-get row :adjustments)
                        (when (eq replacement 'keep) (plist-get (nth 1 (plist-get before :choices)) :adjustments))))
         (should (equal (plist-get after :definition) (plist-get before :definition))))))))

