(ert-deftest emacsvox-aural-voice-editor-field-navigation-stops-at-both-ends ()
  (emacsvox-test--with-voice-editor
   (emacsvox-aural-voice-editor-open 'reading-owned 'bolden)
   (emacsvox-aural-voice-editor--locate 'save)
   (let ((first (point)))
     (call-interactively (key-binding (kbd "<up>")))
     (should (= first (point)))
     (should (string-prefix-p "First field." (car speech)))
     (call-interactively (key-binding (kbd "<down>")))
     (should (> (point) first))
     (call-interactively (key-binding (kbd "<up>")))
     (should (= first (point))))
   (goto-char (button-start (previous-button (point-max))))
   (let ((last (point)))
     (call-interactively (key-binding (kbd "<down>")))
     (should (= last (point)))
     (should (string-prefix-p "Last field." (car speech)))
     (call-interactively (key-binding (kbd "TAB")))
     (should (= last (point)))
     (call-interactively (key-binding (kbd "<up>")))
     (should (< (point) last))
     (call-interactively (key-binding (kbd "<down>")))
     (should (= last (point))))))

(ert-deftest emacsvox-aural-voice-editor-toggle-keys-announce-state-after-distinct-cues ()
  (emacsvox-test--with-voice-editor
   (emacsvox-aural-voice-editor-open 'reading-owned 'bolden)
   (let (events)
     (cl-letf (((symbol-function 'emacsvox-icon) (lambda (icon) (push icon events)))
               ((symbol-function 'tts-speak) (lambda (text &rest _) (push text events))))
       (dolist (case '((more "More adjustments and effects" "expanded" "collapsed")
                       (auto-sample "Automatic sample after adjustment" "off" "on")
                       (fallbacks "Fallbacks" "expanded" "collapsed")))
         (emacsvox-aural-voice-editor--locate (car case))
         (should (eq (key-binding (kbd "RET")) #'emacsvox-aural-voice-editor-activate))
         (dolist (state (cddr case))
           (setq events nil)
           (call-interactively (key-binding (kbd "RET")))
           (should (= (length events) 2))
           (should (string-prefix-p (cadr case) (car events)))
           (should (string-suffix-p state (car events)))
           (should (eq (cadr events) (if (member state '("expanded" "on")) 'on 'off)))
           (should (eq (get-text-property (point) 'voice-field) (car case)))
           (let ((label (car events)))
             (call-interactively (key-binding (kbd "<down>")))
             (call-interactively (key-binding (kbd "<up>")))
             (should (equal (car events) label))))))
     (should-not requests))))

(ert-deftest emacsvox-aural-voice-editor-horizontal-arrows-navigate-nonnumeric-fields ()
  (emacsvox-test--with-voice-editor
   (emacsvox-aural-voice-editor-open 'reading-owned 'bolden)
   (emacsvox-aural-voice-editor--put :effects t)
   (emacsvox-aural-voice-editor-refresh)
   (let ((before (emacsvox-aural-voice-editor--working)))
     (dolist (field '(save primary family more auto-sample))
       (emacsvox-aural-voice-editor--locate field)
       (let ((position (point)))
         (call-interactively (key-binding (kbd "<right>")))
         (should (> (point) position))
         (should (equal (car speech) (button-label (button-at (point)))))))
     (emacsvox-aural-voice-editor--locate 'auto-sample)
     (call-interactively (key-binding (kbd "<left>")))
     (should (eq (get-text-property (point) 'voice-field) 'text))
     (goto-char (point-min))
     (call-interactively (key-binding (kbd "<right>")))
     (should (eq (get-text-property (point) 'voice-field) 'save))
     (should (equal before (emacsvox-aural-voice-editor--working)))
     (should-not requests))))

(ert-deftest emacsvox-aural-voice-editor-default-key-clears-zero-and-can-be-undone ()
  (emacsvox-test--with-voice-editor
   (emacsvox-aural-voice-editor-experiment
    '((:engine-id "test") (:voice-id "one")) (current-buffer) "Sample.")
   (emacsvox-aural-voice-editor--put :effects t)
   (emacsvox-aural-voice-editor-refresh)
   (dolist (dimension '(rate-offset average-pitch low-pass gain pan))
     (emacsvox-aural-voice-editor--locate dimension)
     (emacsvox-aural-voice-editor--set dimension 0)
     (let* ((key (emacsvox-aural--voice-dimension-key dimension))
            (stored (plist-get (plist-get (emacsvox-aural-voice-editor--working) :definition) key)))
       (should (numberp stored))
       (call-interactively (key-binding (kbd "d")))
       (should-not (plist-get (plist-get (emacsvox-aural-voice-editor--working) :definition) key))
       (should (string-match-p "adapter default" (button-label (button-at (point)))))
       (should (equal (plist-get (caar requests) :text) "Adapter default. Sample."))
       (emacsvox-aural-voice-editor-undo)
       (should (equal stored (plist-get (plist-get (emacsvox-aural-voice-editor--working) :definition) key)))))))

(ert-deftest emacsvox-aural-voice-editor-leave-dismisses-window-before-workbench-quit ()
  (emacsvox-test--with-voice-editor
   (save-window-excursion
     (let ((source (generate-new-buffer " *voice-quit-source*"))
           (workbench (generate-new-buffer " *voice-quit-workbench*")))
       (unwind-protect
           (cl-letf (((symbol-function 'emacsvox-speak-mode-line) #'ignore))
             (dolist (same-window '(t nil))
               (delete-other-windows)
               (switch-to-buffer source)
               (let ((display-buffer-overriding-action
                      (if same-window '(display-buffer-same-window)
                        '(display-buffer-pop-up-window))))
                 (pop-to-buffer workbench)
                 (emacsvox-aural-voice-workbench-mode)
                 (setq emacsvox-aural-voice-workbench-view 'engines)
                 (emacsvox-aural-voice-editor-experiment
                  '((:engine-id "test") (:voice-id "one")) workbench "Sample.")
                 (let ((editor (current-buffer))
                       (context emacsvox-aural-voice-editor--context))
                   (call-interactively (key-binding (kbd "q")))
                   (should (eq (current-buffer) workbench))
                   (should (buffer-live-p editor))
                   (should-not (get-buffer-window editor))
                   (call-interactively (key-binding (kbd "q")))
                   (should-not (eq (current-buffer) editor))
                   (should-not (get-buffer-window editor))
                   ;; Leaving retains the experiment, without making it the
                   ;; destination of a later workbench quit.
                   (should (eq (plist-get context :buffer) editor))))))
         (kill-buffer workbench)
         (kill-buffer source))))))

