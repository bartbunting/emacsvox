   (emacsvox-aural-voice-editor--put :automatic-sample t)
   (emacsvox-aural-voice-editor--put :effects t)
   (emacsvox-aural-voice-editor-refresh)
   (dolist (case '((low-pass 1 :low_pass "set" "1.") (richness 0 :richness "set" "0.")
                   (richness nil :richness "default" "Adapter default.")))
     (emacsvox-aural-voice-editor--set (nth 0 case) (nth 1 case))
     (let* ((request (emacsvox-test--omnivox-decode-command (car writes)))
            (rows (plist-get (plist-get request :voice) :choices))
            (operation (plist-get (plist-get (nth 1 rows) :adjustments) (nth 2 case))))
       (should (equal (plist-get request :selection) '(:mode "choice" :choice_id "alternate")))
       (should (= (length rows) 3))
       (should (equal (plist-get operation :op) (nth 3 case)))
       (should (string-prefix-p (nth 4 case) (plist-get request :text)))))
   (should (= (plist-get (plist-get (emacsvox-aural-voice-editor--tuning-row) :adjustments) :low-pass) 8))
   (emacsvox-aural-voice-editor--locate 'richness)
   (emacsvox-aural-voice-editor--inherit)
   (let* ((request (emacsvox-test--omnivox-decode-command (car writes)))
          (row (nth 1 (plist-get (plist-get request :voice) :choices))))
     (should-not (plist-member (plist-get row :adjustments) :richness))
     (should (string-prefix-p "Use shared value," (plist-get request :text))))
   (emacsvox-aural-voice-editor-stop)
   (omnivox-preview-test--clean speaker)))

