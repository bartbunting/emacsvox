(require 'emacsvox-settings-tests)
(require 'emacsvox-tree-settings)

(ert-deftest emacsvox-tree-settings-presets-preserve-labels-and-rules ()
  "Every preset affects only its indication; preview changes no live rules."
  (emacsvox-test--with-capitalization
   (let ((initial (copy-tree (list emacsvox-aural-user-rules emacsvox-aural-session-rules
                                   emacsvox-aural-buffer-rules))))
     (dolist (choice '(speech earcon both tone none inherit))
       (setf (plist-get (emacsvox-tree-settings--draft) :pending)
             (mapcar (lambda (spec) (cons (car spec) choice)) emacsvox-tree-settings--events))
       (let ((runs (emacsvox-tree-settings--preview-runs)))
         (should (= 10 (length runs)))
         (should (cl-every (lambda (run) (and (stringp (cadr run)) (> (length (cadr run)) 0))) runs))
         (cl-loop for run in runs for index from 0 do
                  (let* ((plan (car run))
                         (spoken (emacsvox-aural-concrete-content-speak
                                  (emacsvox-aural-concrete-plan-content plan))))
                    (if (cl-oddp index)
                        (progn (should spoken)
                               (should-not (emacsvox-aural-concrete-plan-before plan)))
                      (should (eq (not (null spoken)) (not (null (memq choice '(speech both inherit)))))))))
         (should (equal initial (list emacsvox-aural-user-rules emacsvox-aural-session-rules
                                      emacsvox-aural-buffer-rules))))))))

(ert-deftest emacsvox-tree-settings-apply-save-inherit-and-failure ()
  "Apply is temporary, Save survives reload, and failures retain the draft."
  (emacsvox-test--with-capitalization
   (let ((unrelated '(:id unrelated :match (:role heading) :render (:content (:voice voice-bolden)))))
     (setq emacsvox-aural-user-rules (list unrelated))
     (setf (plist-get (emacsvox-tree-settings--draft) :pending) '((tree-exited . none)))
     (emacsvox-tree-settings--apply)
     (should (eq 'none (emacsvox-tree-settings--effective 'tree-exited)))
     (should (eq 'speech (emacsvox-tree-settings--effective 'tree-entered)))
     (should-not (file-exists-p emacsvox-aural-schemes-file))
     (emacsvox-tree-settings--save)
     (should (file-exists-p emacsvox-aural-schemes-file))
     (should (member unrelated emacsvox-aural-user-rules))
     (let ((saved (copy-tree emacsvox-aural-user-rules)))
       (setq emacsvox-aural-user-rules nil)
       (emacsvox-aural-load-user-data)
       (should (equal saved emacsvox-aural-user-rules)))
     (setf (plist-get (emacsvox-tree-settings--draft) :pending) '((tree-exited . inherit)))
     (emacsvox-tree-settings--apply)
     (should-not emacsvox-aural-buffer-rules)
     (should (eq 'none (emacsvox-tree-settings--effective 'tree-exited)))
     (emacsvox-tree-settings--save)
     (should (equal (list unrelated) emacsvox-aural-user-rules))
     (should (eq 'speech (emacsvox-tree-settings--effective 'tree-exited)))
     (setf (plist-get (emacsvox-tree-settings--draft) :pending) '((tree-entered . earcon)))
     (cl-letf (((symbol-function 'emacsvox-aural-save-user-data) (lambda (&rest _) (error "write failed"))))
       (should-error (emacsvox-tree-settings--save)))
     (should (equal (list unrelated) emacsvox-aural-user-rules))
     (should (equal '((tree-entered . earcon)) (plist-get (emacsvox-tree-settings--draft) :pending))))))

(ert-deftest emacsvox-tree-settings-graphical-menu-and-choices ()
  "The actual menu opens, arrows only browse, and selection restores focus."
  (emacsvox-test--with-settings
   (execute-kbd-macro (kbd "s Y"))
   (should (eq (oref transient--prefix command) 'emacsvox-tree-settings))
   (execute-kbd-macro (kbd "e <down>"))
   (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
   (execute-kbd-macro (kbd "q e 2"))
   (should (eq (oref transient--prefix command) 'emacsvox-tree-settings))
   (with-selected-window transient--window
     (should (equal "e" (oref (button-get (button-at (point)) 'button-data) key))))
   (should (string-match-p "pending" (emacsvox-tree-settings--label 'tree-entered)))
   (let (runs stopped)
     (cl-letf (((symbol-function 'emacsvox-aural-preview-play-runs) (lambda (value &rest _) (setq runs value)))
               ((symbol-function 'emacsvox-aural-preview-stop) (lambda () (setq stopped t))))
       (execute-kbd-macro (kbd "SPC"))
       (should (derived-mode-p 'emacsvox-tree-settings-preview-mode))
       (execute-kbd-macro (kbd "<down> s q")))
     (should (equal "Tree. Finance" (mapconcat #'cadr runs "")))
     (should stopped))
   (should-not (file-exists-p emacsvox-aural-schemes-file))
   (execute-kbd-macro (kbd "A"))
   (should (eq 'earcon (emacsvox-tree-settings--effective 'tree-entered)))
   (execute-kbd-macro (kbd "q Y"))
   (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
   (should (eq 'earcon (emacsvox-tree-settings--effective 'tree-entered)))
   (execute-kbd-macro (kbd "q q q"))
   (should (eq (current-buffer) source))))

(ert-deftest emacsvox-tree-settings-graphical-help-search-and-source ()
  "Search selects event controls; Help and cancelled choices preserve the draft."
  (emacsvox-test--with-settings
   (dolist (entry '(("Tree entry feedback speech earcon or tone" . "e")
                    ("Tree exit feedback" . "x")
                    ("Tree level change feedback" . "l")))
     (execute-kbd-macro (vconcat (kbd "/") (car entry) (kbd "RET")))
     (should (eq (oref transient--prefix command) 'emacsvox-tree-settings))
     (with-selected-window transient--window
       (should (equal (cdr entry) (oref (button-get (button-at (point)) 'button-data) key))))
     (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
     (execute-kbd-macro (kbd "q")))
   (execute-kbd-macro (kbd "s Y e <down> <down>"))
   (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
   (execute-kbd-macro (kbd "? 4"))
   (should (get-buffer-window (help-buffer)))
   (should (with-current-buffer (help-buffer) (string-match-p "depth" (buffer-string))))
   (with-selected-window (get-buffer-window (help-buffer)) (execute-kbd-macro (kbd "q")))
   (should (eq (oref transient--prefix command) 'emacsvox-tree-settings--choice-menu))
   (execute-kbd-macro (kbd "q h"))
   (should (get-buffer-window (help-buffer)))
   (with-selected-window (get-buffer-window (help-buffer)) (execute-kbd-macro (kbd "q")))
   (should (eq (oref transient--prefix command) 'emacsvox-tree-settings))
   (let ((context (emacsvox-tree-settings--context)))
     (execute-kbd-macro (kbd "C-q"))
     (kill-buffer source)
     (let ((transient--prefix (transient-prefix :command 'emacsvox-tree-settings :scope context)))
       (should-error (emacsvox-tree-settings--apply) :type 'user-error)))))

(ert-deftest emacsvox-tree-settings-session-and-selective-inheritance ()
  "Session changes preserve other rules and local inheritance follows them."
  (emacsvox-test--with-capitalization
   (setf (plist-get (emacsvox-tree-settings--draft) :pending) '((tree-entered . both)))
   (emacsvox-tree-settings--session)
   (should-not (file-exists-p emacsvox-aural-schemes-file))
   (should (eq 'both (emacsvox-tree-settings--effective 'tree-entered)))
   (setf (plist-get (emacsvox-tree-settings--draft) :pending) '((tree-entered . none)))
   (emacsvox-tree-settings--apply)
   (should (eq 'none (emacsvox-tree-settings--effective 'tree-entered)))
   (setf (plist-get (emacsvox-tree-settings--draft) :pending) '((tree-entered . inherit)))
   (emacsvox-tree-settings--apply)
   (should (eq 'both (emacsvox-tree-settings--effective 'tree-entered)))
   (emacsvox-tree-settings--discard)
   (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
   (should (eq 'both (emacsvox-tree-settings--effective 'tree-entered)))))

(ert-deftest emacsvox-tree-settings-graphical-enter-selects-and-restores ()
  "Return opens event choices and stages a browsed value without applying it."
  (dolist (key '("RET" "<return>" "M-RET" "M-<return>" "C-j"))
    (emacsvox-test--with-settings
     (execute-kbd-macro (kbd "s Y <down>"))
     (execute-kbd-macro (kbd key))
     (should (eq (oref transient--prefix command) 'emacsvox-tree-settings--choice-menu))
     (execute-kbd-macro (kbd "<down>"))
     (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
     (execute-kbd-macro (kbd key))
     (should (eq (oref transient--prefix command) 'emacsvox-tree-settings))
     (should (eq 'earcon (alist-get 'tree-entered
                                    (plist-get (emacsvox-tree-settings--draft) :pending))))
     (should (eq 'speech (emacsvox-tree-settings--effective 'tree-entered)))
     (with-selected-window transient--window
       (should (equal "e" (oref (button-get (button-at (point)) 'button-data) key)))))))


(ert-deftest emacsvox-tree-settings-depth-components-and-persistence ()
  "Depth pitch follows movement; speech and an earcon remain independent."
  (emacsvox-test--with-capitalization
   (emacsvox-tree-settings--level-set :tone t)
   (emacsvox-tree-settings--level-set :voice 'voice-bolden)
   (emacsvox-tree-settings--level-set :earcon 'item)
   (let* ((runs (emacsvox-tree-settings--preview-runs))
          (plans (mapcar (lambda (index) (car (nth index runs))) '(2 4 6)))
          (tones (mapcar (lambda (plan) (car (emacsvox-aural-concrete-plan-before plan))) plans))
          (pitches (mapcar #'emacsvox-aural-concrete-action-pitch tones)))
     (should (< (nth 0 pitches) (nth 1 pitches)))
     (should (= (nth 0 pitches) (nth 2 pitches)))
     (dolist (plan plans)
       (should (emacsvox-aural-concrete-content-speak (emacsvox-aural-concrete-plan-content plan)))
       (should (eq 'item (emacsvox-aural-concrete-action-cue
                          (cadr (emacsvox-aural-concrete-plan-before plan))))))
     (dolist (index '(0 1 3 5 7 8 9))
       (should-not (emacsvox-aural-concrete-plan-before (car (nth index runs))))))
   (emacsvox-tree-settings--save)
   (setq emacsvox-aural-user-rules nil)
   (emacsvox-aural-load-user-data)
   (let ((value (emacsvox-tree-settings--level-value)))
     (should (eq t (plist-get value :tone)))
     (should (eq 'voice-bolden (plist-get value :voice)))
     (should (eq 'item (plist-get value :earcon))))
   (emacsvox-tree-settings--level-speech)
   (let ((plan (car (nth 2 (emacsvox-tree-settings--preview-runs)))))
     (should-not (emacsvox-aural-concrete-content-speak (emacsvox-aural-concrete-plan-content plan)))
     (should (= 2 (length (emacsvox-aural-concrete-plan-before plan)))))))

(ert-deftest emacsvox-tree-settings-graphical-level-controls ()
  "Return toggles a level component; Help and Back retain staged choices."
  (emacsvox-test--with-settings
   (execute-kbd-macro (kbd "s Y l <down> <down> <down>"))
   (should (eq (oref transient--prefix command) 'emacsvox-tree-settings--level-menu))
   (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
   (execute-kbd-macro (kbd "RET"))
   (should (plist-get (emacsvox-tree-settings--level-value) :tone))
   (should (plist-get (emacsvox-tree-settings--level-value) :speech))
   (execute-kbd-macro (vconcat (kbd "v") "voice-bolden" (kbd "RET")))
   (should (eq 'voice-bolden (plist-get (emacsvox-tree-settings--level-value) :voice)))
   (execute-kbd-macro (vconcat (kbd "e") "item" (kbd "RET")))
   (should (eq 'item (plist-get (emacsvox-tree-settings--level-value) :earcon)))
   (execute-kbd-macro (kbd "h"))
   (should (get-buffer-window (help-buffer)))
   (with-selected-window (get-buffer-window (help-buffer)) (execute-kbd-macro (kbd "q")))
   (should (eq (oref transient--prefix command) 'emacsvox-tree-settings--level-menu))
   (execute-kbd-macro (kbd "q A"))
   (should (eq (oref transient--prefix command) 'emacsvox-tree-settings))
   (emacsvox-tree-settings--discard)
   (should (eq t (plist-get (emacsvox-tree-settings--level-value) :tone)))))

(ert-deftest emacsvox-tree-settings-preserves-existing-fixed-tone ()
  "Changing level speech retains a previously chosen fixed tone."
  (emacsvox-test--with-capitalization
   (setf (plist-get (emacsvox-tree-settings--draft) :pending) '((tree-level-changed . tone)))
   (emacsvox-tree-settings--apply)
   (emacsvox-tree-settings--discard)
   (should (eq 'fixed (plist-get (emacsvox-tree-settings--level-value) :tone)))
   (emacsvox-tree-settings--level-speech)
   (let* ((plan (car (nth 2 (emacsvox-tree-settings--preview-runs))))
          (tone (car (emacsvox-aural-concrete-plan-before plan))))
     (should (emacsvox-aural-concrete-content-speak (emacsvox-aural-concrete-plan-content plan)))
     (should (= 440 (emacsvox-aural-concrete-action-pitch tone))))))

(ert-deftest emacsvox-tree-settings-graphical-tone-editor-and-browser ()
  "Tone editing, interactive movement and return preserve the parent draft."
  (emacsvox-test--with-settings
   (execute-kbd-macro (kbd "s Y l t T"))
   (should (eq (oref transient--prefix command) 'emacsvox-tone-editor))
   (execute-kbd-macro (kbd "p 3 0 0 RET j 7 RET m 1 2 0 0 RET d 8 0 RET v 3 5 RET w t"))
   (should (= 300 (emacsvox-tone-editor--get :pitch)))
   (should (eq 'triangle (emacsvox-tone-editor--get :waveform)))
   (let ((parent (copy-tree (plist-get (emacsvox-tree-settings--draft) :pending))) runs)
     (cl-letf (((symbol-function 'emacsvox-aural-preview-play-runs) (lambda (value &rest _) (setq runs value))))
       (execute-kbd-macro (kbd "SPC"))
       (let ((tone (car (emacsvox-aural-concrete-plan-before (caar runs)))))
         (should (= 300 (emacsvox-aural-concrete-action-pitch tone)))
         (should (= 80 (emacsvox-aural-concrete-action-duration tone)))
         (should (= 0.35 (emacsvox-aural-concrete-action-requested-volume tone))))
       (execute-kbd-macro (kbd "P"))
       (should (derived-mode-p 'emacsvox-tree-settings-preview-mode))
       (execute-kbd-macro (kbd "<down>"))
       (should (equal "Tree. Finance" (mapconcat #'cadr runs "")))
       (execute-kbd-macro (kbd "<down>"))
       (should (equal "Level 1. Cash forecast" (mapconcat #'cadr runs "")))
       (should (< 449 (emacsvox-aural-concrete-action-pitch
                       (car (emacsvox-aural-concrete-plan-before (caar runs)))) 450))
       (execute-kbd-macro (kbd "<down> <down>"))
       (should (equal "Expected receipts" (mapconcat #'cadr runs "")))
       (should-not (emacsvox-aural-concrete-plan-before (caar runs)))
       (execute-kbd-macro (kbd "<down> <down>"))
       (should (equal "End of tree. Outside the tree." (mapconcat #'cadr runs "")))
       (execute-kbd-macro (kbd "<up>"))
       (should (equal "Tree. Level 1. Planning" (mapconcat #'cadr runs "")))
       (execute-kbd-macro (kbd "q")))
     (should (eq (oref transient--prefix command) 'emacsvox-tone-editor))
     (should (equal parent (plist-get (emacsvox-tree-settings--draft) :pending))))
   (execute-kbd-macro (kbd "A q q W"))
   (emacsvox-aural-load-user-data)
   (let ((data (plist-get (emacsvox-tree-settings--level-value) :tone-data)))
     (should (= 300 (plist-get data :pitch)))
     (should (= 7 (plist-get data :semitones)))
     (should (= 1200 (plist-get data :maximum)))
     (should (= 80 (plist-get data :duration)))
     (should (= 35 (plist-get data :volume)))
     (should (eq 'triangle (plist-get data :waveform))))))

(ert-deftest emacsvox-tree-settings-depth-expression-validation ()
  "Depth mapping is bounded, requires numeric depth and rejects invalid rules."
  (emacsvox-test--with-capitalization
   (let ((render '(:before (:append ((:id depth :kind tone
                                          :pitch (:pitch-from-depth tree-depth 300 7 1200)
                                          :duration 50))))))
     (should-error (emacsvox-aural-compile-rule
                    (list :id 'missing-depth :match '(:role tree-indicator) :render render) 'user))
     (let ((rule (emacsvox-aural-compile-rule
                  (list :id 'depth :match '(:role tree-indicator :requires (tree-depth)) :render render) 'user)))
       (dolist (step '((0 . 300) (12 . 1200) (100000000 . 1200)))
         (let* ((facts (list :role 'tree-indicator :tree-depth (car step)))
                (plan (emacsvox-aural-compile-plan (emacsvox-aural-resolve facts nil (list rule)) facts nil)))
           (should (= (cdr step) (emacsvox-aural-concrete-action-pitch
                                  (car (emacsvox-aural-concrete-plan-before plan)))))))))
   (dolist (pitch '((:pitch-from-depth tree-depth 0 3 1000)
                    (:pitch-from-depth tree-depth 220 -1 1000)
                    (:pitch-from-depth tree-depth 220 3 100)
                    (:pitch-from-depth tree-depth 220 3 30000)))
     (should-error (emacsvox-aural-compile-rule
                    `(:id invalid :match (:role tree-indicator :requires (tree-depth))
                          :render (:before (:append ((:id bad :kind tone :pitch ,pitch :duration 50))))) 'user)))))

(ert-deftest emacsvox-tree-settings-graphical-presets-keep-depth-mapping ()
  "Sound presets retain depth settings; keeping enables the pending depth tone."
  (emacsvox-test--with-settings
   (execute-kbd-macro (kbd "s Y l T j 7 RET m 3 0 0 0 RET L 1"))
   (should (= 7 (emacsvox-tone-editor--get :semitones)))
   (should (= 3000 (emacsvox-tone-editor--get :maximum)))
   (should (= 880 (emacsvox-tone-editor--get :pitch)))
   (should-not (plist-get (emacsvox-tree-settings--draft) :pending))
   (execute-kbd-macro (kbd "A q"))
   (should (eq t (plist-get (emacsvox-tree-settings--level-value) :tone)))
   (should-not emacsvox-aural-buffer-rules)
   (execute-kbd-macro (kbd "T p 4 0 0 RET q"))
   (should (= 880 (plist-get (emacsvox-tree-settings--tone-read) :pitch)))
   (execute-kbd-macro (kbd "q A"))
   (emacsvox-tree-settings--discard)
   (should (= 7 (plist-get (emacsvox-tree-settings--tone-read) :semitones)))
   (should (= 3000 (plist-get (emacsvox-tree-settings--tone-read) :maximum)))))

(provide 'emacsvox-tree-settings-tests)
