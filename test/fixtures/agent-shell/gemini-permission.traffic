(((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . #1="2.0") (method . "initialize") (id . 1)
           (params (protocolVersion . 1)
                   (clientCapabilities
                    (fs (readTextFile . :false)
                        (writeTextFile . :false))))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 1)
           (result (protocolVersion . 1)
                   (authMethods
                    . [((id . "oauth-personal")
                        (name . "Log in with Google")
                        (description . :null))
                       ((id . "gemini-api-key")
                        (name . "Use Gemini API key")
                        (description
                         . "Requires setting the `GEMINI_API_KEY` environment variable"))
                       ((id . "vertex-ai") (name . "Vertex AI")
                        (description . :null))])
                   (agentCapabilities (loadSession . :false)
                                      (promptCapabilities (image . t)
                                                          (audio . t)
                                                          (embeddedContext
                                                           . t))))))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . #1#) (method . "authenticate") (id . 2)
           (params (methodId . "gemini-api-key"))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 2) (result . :null)))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . #1#) (method . "session/new") (id . 3)
           (params
            (cwd . "/example/project/")
            (mcpServers . #3=[]))))
 ((:direction . incoming) (:kind . response)
  (:object (jsonrpc . "2.0") (id . 3)
           (result
            (sessionId . #2="session-example-1"))))
 ((:direction . outgoing) (:kind . request)
  (:object (jsonrpc . #1#) (method . "session/prompt") (id . 4)
           (params (sessionId . #2#)
                   (prompt
                    . [((type . "text")
                        (text . "Show the first sample revision."))]))))
 ((:direction . incoming) (:kind . notification)
  (:object (jsonrpc . "2.0") (method . "session/update")
           (params
            (sessionId . "session-example-1")
            (update (sessionUpdate . "agent_thought_chunk")
                    (content (type . "text")
                             (text
                              . "Check the sample history."))))))
 ((:direction . incoming) (:kind . notification)
  (:object (jsonrpc . "2.0") (method . "session/update")
           (params
            (sessionId . "session-example-1")
            (update (sessionUpdate . "agent_thought_chunk")
                    (content (type . "text")
                             (text
                              . "Prepare the command."))))))
 ((:direction . incoming) (:kind . notification)
  (:object (jsonrpc . "2.0") (method . "session/update")
           (params
            (sessionId . "session-example-1")
            (update (sessionUpdate . "agent_message_chunk")
                    (content (type . "text")
                             (text
                              . "May I inspect the example history?"))))))
 ((:direction . incoming) (:kind . request)
  (:object (jsonrpc . "2.0") (id . 0)
           (method . "session/request_permission")
           (params
            (sessionId . "session-example-1")
            (options
             . [((optionId . "proceed_always")
                 (name . "Always Allow git, head")
                 (kind . "allow_always"))
                ((optionId . "proceed_once") (name . "Allow")
                 (kind . "allow_once"))
                ((optionId . "cancel") (name . "Reject")
                 (kind . "reject_once"))])
            (toolCall (toolCallId . "tool-example-1")
                      (status . "pending")
                      (title
                       . "git log --oneline --reverse | head -1 (List the first sample revision.)")
                      (content . #3#) (locations . #3#)
                      (kind . "execute"))))))
