#!/bin/sh

set -eu

# Compatibility entry point for the former github-release helper.  Keep every
# publication path behind the same version, source, artifact, and tag checks.
script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
root=$(CDPATH= cd -- "$script_directory/.." && pwd)
version=$(sed -n '1p' "$root/VERSION")

if [ "$#" -gt 2 ]; then
    printf 'usage: %s [VERSION [ARCHIVE]]\n' "$0" >&2
    exit 2
fi
if [ "$#" -ge 1 ] && [ "$1" != "$version" ]; then
    printf 'emacsvox-ghr: requested version %s; VERSION contains %s\n' \
        "$1" "$version" >&2
    exit 1
fi
if [ "$#" -eq 2 ]; then
    expected=emacsvox-$version.tar.bz2
    actual=$(basename -- "$2")
    if [ "$actual" != "$expected" ]; then
        printf 'emacsvox-ghr: requested artifact %s; expected %s\n' \
            "$actual" "$expected" >&2
        exit 1
    fi
fi

printf '%s\n' \
    'emacsvox-ghr is deprecated; delegating to the guarded release-publish target.' \
    >&2
exec make -C "$root" release-publish
