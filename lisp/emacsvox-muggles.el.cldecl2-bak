;;; Commentary:

;; MUGGLES ==  Emacsvox spells for power-users.

;; This module implements no new functionality --- contrast with
;; emacsvox-wizards.  Instead, it uses package hydra to provide
;; convenience key-bindings that access existing Emacsvox
;; functionality.
;; You need to install package Hydra first:
;; @samp{M-x package-install  hydra}.

;; Note that on newer versions of Emacs, loading this module will
;; attempt to automatically install package hydra if it is not found.
;; @subsection Using Hydras
;; See the high-level documentation for the Hydra package by executing
;; @kbd {C-h C-j } hydra @kbd{RET}.
;; The documentation in this section uses the same terminology as
;; shown in the hydra package documentation.

;; @subsection Implemented Muggles

;; @itemize
;; @item Brightness: @kbd{print} Control display brightness using light.
;; @item Navigate: @kbd{s-n} Navigate with ease.
;; @item  org-mode tables: @kbd{C-c t} Table UI for org-mode tables.
;; @item hideshow: C-, h Provide HideShow bindings.
;; @item toggle-option:  @kbd{C-c o} Single binding for toggling options.
;; @item Repeatable-Yank: @kbd{C-y} Smart yank
;; @item undo-only/undo-redo: @kbd{C-/ } Undo-only on @kbd{/} and
;; undo-redo on @kbd{\}
;; @item emacsvox-maths @kbd{s-SPC} Speak and browse math.
;; @end itemize

;; Emacsvox automatically speaks Hydra hints when displayed.
;; To silence all Hydra hints, set hydra-is-helpful to nil.  To
;; temporarily silence speaking of Hydra hints, Muggles can bind
;; command @code{emacsvox-hydra-toggle-talkative}.  As an
;; example, Muggle @samp{ViewMode} binds @code{s} to this command.

;;; Code:

;;   Required modules:

(eval-when-compile (require 'cl-lib)
                   (setq byte-compile-warnings '(not docstrings)))
(cl-declaim  (optimize  (safety 0) (speed 3)))
(require 'emacsvox-preamble)
(require 'hydra "hydra" 'no-error)
(require 'emacsvox-hydra)
(require 'org)
(require 'hideshow)
(require 'ido)
(require 'emacsvox-maths nil 'no-error)
(require 'emacsvox-outline)
(require 'emacsvox-dired)
(require 'smartparens "smartparens" 'no-error)
(require 'browse-kill-ring "browse-kill-ring" 'no-error)
(require 'xbacklight)
(require 'view)
(require 'emacsvox-m-player)

;; Don't burp if absent during compilation.
(declare-function org-table-previous-row "emacsvox-org" nil)
(declare-function emacsvox-org-table-speak-current-element
                  "emacsvox-org" nil)
(declare-function emacsvox-org-table-speak-coordinates "emacsvox-org" nil)
(declare-function emacsvox-org-table-speak-both-headers-and-element
                  "emacsvox-org" nil)
(declare-function
 emacsvox-org-table-speak-row-header-and-element "emacsvox-org" nil)
(declare-function emacsvox-org-table-speak-column-header-and-element
                  "emacsvox-org" nil)

;;;  Brightness:

(global-set-key
 (kbd "<print>")
 (defhydra
  emacsvox-muggles-brightness
  (:body-pre
   (progn
     (when hydra-is-helpful (emacsvox-hydra-toggle-talkative))
     (emacsvox-hydra-body-pre "brightness"))
   :hint nil
   :pre emacsvox-hydra-pre
   :post emacsvox-hydra-post)
  "Brightness "
  ("?" (emacsvox-hydra-self-help "emacsvox-muggles-brightness") "Help")
  ("s" light-set "set")
  ("g" light-get "Get")
  ("t" emacsvox-hydra-toggle-talkative)
  ("<print>" light-black "black" :color blue)
  ("s-." light-black "black" :color blue)
  ("." light-black "black" :color blue)
  ("0" light-black "black" :color blue)
  ("1" light-white  "white" :color blue)
  ("d" light-decrement "dimmer")
  ("i" light-increment "brighter")
  ("SPC" light-increment "brighter")))

(global-set-key (kbd "s-.") 'emacsvox-muggles-brightness/body)

;;;  Org-Mode Table Navigation:
(with-eval-after-load "org"
  (define-key
   org-mode-map (kbd "C-c t")
   (defhydra emacsvox-muggles-org-table
             (:body-pre
              (progn
                (emacsvox-hydra-body-pre "Org Table UI")
                (when hydra-is-helpful (emacsvox-hydra-toggle-talkative)))
              :pre emacsvox-hydra-pre :post emacsvox-hydra-post)
             "Org Table UI"
             ("?"(emacsvox-hydra-self-help "emacsvox-muggles-org-table"))
             ("j" org-table-next-row)
             ("k" org-table-previous-row)
             ("h" org-table-previous-field)
             ("l" org-table-next-field)
             ("SPC"emacsvox-org-table-speak-current-element)
             ("."emacsvox-org-table-speak-coordinates)
             ("b"emacsvox-org-table-speak-both-headers-and-element)
             ("r"emacsvox-org-table-speak-row-header-and-element)
             ("c"emacsvox-org-table-speak-column-header-and-element))))

;;;  HideShow:

(global-set-key
 (kbd "C-, h")
 (defhydra  emacsvox-muggles-hideshow
            (
             :body-pre
             (progn
               (emacsvox-hydra-body-pre  "Hide Show")
               (hs-minor-mode 1))
             :pre emacsvox-hydra-pre :post emacsvox-hydra-post :color blue)
            "Hideshow"
            ("?" (emacsvox-hydra-self-help "emacsvox-muggles-hideshow"))
            ("h" hs-hide-block)
            ("s" hs-show-block)
            ("H" hs-hide-all)
            ("S" hs-show-all)
            ("a"  hs-show-all)
            ("l" hs-hide-level)
            ("i" hs-hide-initial-comment-block)))

;;;  Option Toggle

;; Cloned from hydra-examples.el and modified to tase.
;;; Helper:

(defun emacsvox-muggles-lispy-or-sp ()
  "Toggle between lispy and smartparens."
  (interactive)
  (lispy-mode 'toggle)
  (smartparens-mode 'toggle)
  (emacsvox-icon 'button)
  (message "Now using %s"
           (cond
            (lispy-mode "Lispy")
            (smartparens-mode "Smart Parens")
            (t "neither lispy or sp"))))

(global-set-key
 (kbd "C-c o")
 (defhydra
  emacsvox-muggles-toggle-option
  (
   :color blue
   :body-pre (emacsvox-hydra-body-pre "Toggle Option ")
   :pre
   (progn
     (emacsvox-hydra-pre)
     (unless hydra-is-helpful (emacsvox-hydra-toggle-talkative)))
   :post emacsvox-hydra-post)
  "
_a_ abbrev-mode: %`abbrev-mode
_d_ debug-on-error:    %`debug-on-error
_g_ debug-on-quit:    %`debug-on-quit
_h_ hydra-is-helpful    %`hydra-is-helpful
_p_ emacsvox-muggles-lispy-or-sp:
"
  ("?" (emacsvox-hydra-self-help "emacsvox-muggles-toggle-option"))
  ("a" (call-interactively #'abbrev-mode))
  ("d" (call-interactively #'toggle-debug-on-error))
  ("g"  (call-interactively #'toggle-debug-on-quit))
  ("h" (setq hydra-is-helpful (not hydra-is-helpful)))
  ("p" emacsvox-muggles-lispy-or-sp)
  ("q" nil "quit")))

;;;  Navigate:

;; Inspired by  Hydra wiki:
;; But bound to s-n --- instead of C-n

(global-set-key
 (kbd "s-n")
 (defhydra emacsvox-muggles-navigate
           (:body-pre
            (progn
              (emacsvox-hydra-body-pre "Navigator")
              (emacsvox-hydra-toggle-talkative)
              (condition-case nil (call-interactively #'next-line) (error nil)))
            :hint nil
            :pre emacsvox-hydra-pre :post emacsvox-hydra-post)
           "Navigator"
           ("?" (emacsvox-hydra-self-help "emacsvox-muggles-navigate"))
           ("s" emacsvox-hydra-toggle-talkative "quiet")
           ("n" next-line "next ")
           ("p" previous-line "previous ")
           ("f" forward-char)
           ("b" backward-char)
           ("a" beginning-of-line)
           ("e" move-end-of-line)
           ("j" next-line)
           ("k" previous-line)
           ("v" scroll-up-command)
           ;; Converting M-v to V here by analogy.
           ("V" scroll-down-command)
           ("l" recenter-top-bottom)
           ("<" beginning-of-buffer)
           (">" end-of-buffer)))

;;;  Repeatable Yank

;; Repeatable yank(-pop) command, with an option to switch to a list view using
;; browse-kill-ring.

;; Helper: IDo Search for kill ring

(defun emacsvox-muggles-ido-yank ()
  "Pick what to yank using ido completion."
  (interactive)
  (when (eq last-command 'yank)
    (delete-region (region-beginning) (region-end)))
  (let ((orig (point)))
    (insert
     (ido-completing-read
      "Yank what? " (mapcar 'substring-no-properties kill-ring)))
    (when (called-interactively-p 'interactive)
      (emacsvox-icon 'yank-object)
      (emacsvox-speak-region orig (point)))))

(global-set-key (kbd "M-C-y") 'emacsvox-muggles-ido-yank)

(defhydra
 emacsvox-muggles-yank-pop
 (:body-pre (emacsvox-hydra-body-pre "Yank")
            :pre
            (progn
              (when hydra-is-helpful (emacsvox-hydra-toggle-talkative))
              (emacsvox-hydra-pre))
            :post emacsvox-hydra-post)
 "Yank"
 ("?" (emacsvox-hydra-self-help "emacsvox-muggles-yank-pop"))
 ("C-y" yank nil)
 ("M-y" yank-pop nil)
 ("y" (funcall-interactively #'yank-pop 1) "next")
 ("Y" (funcall-interactively #'yank-pop -1) "prev")
 ("i" emacsvox-muggles-ido-yank "IDo Yank" :color blue)
 ("s" emacsvox-muggles-ido-yank "IDo Yank" :color blue)
 ("l" browse-kill-ring "list" :color blue))

(global-set-key (kbd "M-y") #'emacsvox-muggles-yank-pop/yank-pop)
(global-set-key (kbd "C-y") #'emacsvox-muggles-yank-pop/yank)

;;;  Repeatable Undo

;; Repeatable undo-only and undo-redo
(global-set-key
 (kbd "s-/")
 (defhydra
  emacsvox-muggles-undo-only/undo-redo
  (:body-pre (emacsvox-hydra-body-pre "Undo Smartly")
             :pre
             (progn
               (when hydra-is-helpful (emacsvox-hydra-toggle-talkative))
               (emacsvox-hydra-pre))
             :post emacsvox-hydra-post)
  "Undo"
  ("?" (emacsvox-hydra-self-help "emacsvox-muggles-undo-only/undo-redo"))
  ("/" undo-only nil)
  ("\\" undo-redo nil)))

;;;   Speak And Browse Math

(global-set-key
 (kbd "s-m")
 (defhydra emacsvox-muggles-maths-navigator
           (:body-pre
            (progn
              (when hydra-is-helpful (emacsvox-hydra-toggle-talkative))
              (emacsvox-hydra-body-pre "Spoken Math"))
            :pre emacsvox-hydra-pre
            :post emacsvox-hydra-post)
           "Spoken Math"
           ("o" emacsvox-maths-switch-to-output :color blue)
           ("RET" emacsvox-maths-enter-guess)
           ("SPC" emacsvox-maths-enter "enter")
           ("a" emacsvox-maths-speak-alt "Alt Text")
           ("d" emacsvox-maths-depth "Depth")
           ("r" emacsvox-maths-root "Root")
           ("<up>" emacsvox-maths-up "Up")
           ("<down>" emacsvox-maths-down"down")
           ("<left>" emacsvox-maths-left "left")
           ("<right>" emacsvox-maths-right "right")))

(provide 'emacsvox-muggles)
;;;  end of file

;; byte-compile-warnings: (docstring  noruntime)
