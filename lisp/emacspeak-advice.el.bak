	((orig (save-excursion (skip-syntax-backward "^ >_") (point))))
      (apply orig-fun args)
      (when (ems-interactive-p)
	(dtk-speak (buffer-substring orig (point)))
	(emacspeak-icon 'complete))
      result)
    result))


