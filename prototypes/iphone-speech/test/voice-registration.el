(require 'ert)
(require 'omnivox-voices)

(ert-deftest iphone-voice-languages-filter-the-browser-and-keep-complete-worker-data ()
  (let ((phone (make-pipe-process :name "phone languages" :noquery t))
        (emacsvox-voice-browser-languages '("en" "fr")))
    (unwind-protect
        (let* ((voices (mapcar (lambda (row)
                                 (list :id (list :voice_id (car row)) :display_name (car row) :language (cadr row)))
                               '(("Reed" "en_US") ("Flo" "en-US") ("French" "fr-CA") ("Spanish" "es"))))
               (inventory (list :engines (list (list :id "ios" :voices voices)))))
          (process-put phone omnivox--control-inventory-property inventory)
          (should (equal (mapcar #'car (iphone-voices--rows phone)) '("Reed" "Flo" "French")))
          (should (equal (mapcar #'car (iphone-voices--rows phone t)) '("Reed" "Flo" "French" "Spanish")))
          (should (eq inventory (process-get phone omnivox--control-inventory-property))))
      (delete-process phone))))

(ert-deftest iphone-registration-prefers-the-shared-directory-alternative-to-reading ()
  (let* ((phone (make-pipe-process :name "directory voice check" :noquery t))
         (choices '((:id "desktop" :selector (:kind exact :scope local :engine-id "dectalk" :voice-id "harry")
                         :adjustments nil)
                    (:id "phone" :selector (:kind exact :scope local :engine-id "ios" :voice-id "Flo")
                         :adjustments (:gain 3))))
         (iphone-frame-speech--settings '(:reading "Reed")))
    (unwind-protect
        (dolist (mode '(nil "legacy" "layered" "engine_layered"))
          (let* ((layered (member mode '("layered" "engine_layered")))
                 (wire (omnivox--native-choice-records-json choices))
                 (definition (append '(:id "dired_directory")
                                     (if layered (list :choices wire)
                                       (list :preferences (vconcat (mapcar (lambda (r) (plist-get r :selector)) wire))))))
                 (content (list :definitions (vector (if mode (list :mode mode :definition definition) definition))
                                :choice-provenance (vector (list :logical-id "dired_directory" :choices choices))
                                :fallback_policy (list :global_default :null)))
                 (read-ids (lambda (c)
                             (let* ((row (aref (plist-get c :definitions) 0))
                                    (d (or (plist-get row :definition) row)))
                               (mapcar (lambda (r) (plist-get (or (plist-get r :selector) r) :voice_id))
                                       (or (plist-get d :choices) (plist-get d :preferences)))))))
            (process-put phone 'iphone-wire t)
            (should (equal (funcall read-ids (iphone-voices--registration (lambda (_) content) phone))
                           '("harry" "Flo" "Reed")))
            (process-put phone 'iphone-wire nil)
            (should (equal (funcall read-ids (iphone-voices--registration (lambda (_) content) phone))
                           '("harry" "Flo")))))
      (delete-process phone))))

(ert-deftest iphone-registration-leaves-language-fallback-ahead-of-the-reading-voice ()
  (let ((phone (make-pipe-process :name "French language role" :noquery t))
        (iphone-frame-speech--settings '(:reading "Reed" :roles ((:role "pinned" :voice "Flo")))))
    (unwind-protect
        (progn
          (process-put phone 'iphone-wire t)
          (dolist (mode '(nil "legacy" "layered" "engine_layered"))
            (dolist (id '("French" "pinned"))
              (let* ((choices '((:id "requested" :selector (:kind exact :scope local :engine-id "ios"
                                                         :voice-id "Missing") :adjustments nil)))
                     (wire (omnivox--native-choice-records-json choices))
                     (layered (member mode '("layered" "engine_layered")))
                     (definition (append (list :id id :language "fr-CA")
                                         (if layered (list :choices wire)
                                           (list :preferences (vector (plist-get (aref wire 0) :selector))))))
                     (content (list :definitions (vector (if mode (list :mode mode :definition definition) definition))
                                    :choice-provenance (vector (list :logical-id id :choices choices))
                                    :fallback_policy '(:global_default :null)))
                     (result (iphone-voices--registration (lambda (_) content) phone))
                     (row (aref (plist-get result :definitions) 0))
                     (data (or (plist-get row :definition) row)))
                (should (equal (mapcar (lambda (r) (plist-get (or (plist-get r :selector) r) :voice_id))
                                       (or (plist-get data :choices) (plist-get data :preferences)))
                               (if (equal id "pinned") '("Flo" "Missing") '("Missing"))))
                (should (equal (plist-get (plist-get (plist-get result :fallback_policy) :global_default) :voice_id)
                               "Reed"))))))
      (delete-process phone))))

(ert-deftest iphone-registration-falls-back-to-the-installed-phone-default ()
  (let ((phone (make-pipe-process :name "phone inventory" :noquery t))
        (content '(:definitions [] :fallback_policy (:global_default :null))))
    (unwind-protect
        (progn
          (process-put phone 'iphone-wire t)
          (process-put phone omnivox--control-inventory-property
                       '(:engines ((:id "ios" :default_voice_id "reed"
                                   :voices ((:id (:voice_id "reed")) (:id (:voice_id "alternate")))))))
          (dolist (pair '((nil "reed") ("removed" "reed") ("alternate" "alternate")))
            (let* ((iphone-frame-speech--settings (list :reading (car pair)))
                   (result (iphone-voices--registration (lambda (_) content) phone)))
              (should (equal (plist-get (plist-get (plist-get result :fallback_policy) :global_default)
                                        :voice_id) (cadr pair)))))
          (should (eq (plist-get (plist-get content :fallback_policy) :global_default) :null)))
      (delete-process phone))))

(ert-deftest iphone-registration-keeps-choice-occurrences-and-desktop-settings ()
  (let* ((phone (make-pipe-process :name "test phone registration" :noquery t))
         (selector '(:kind exact :scope local :engine-id "ios" :voice-id "reed"))
         (collision (concat "iphone-" (secure-hash 'sha256 "reading")))
         (choices (list (list :id collision :selector '(:kind engine-default :scope portable
                                                         :engine-id "other") :adjustments nil)
                        (list :id "loud" :selector selector :adjustments '(:gain 8))
                        (list :id "soft" :selector selector :adjustments '(:gain 3))))
         (iphone-frame-speech--settings '(:reading "reading" :roles ((:role "heading" :voice "reed")))))
    (unwind-protect
        (dolist (mode '("layered" "engine_layered"))
          (let* ((wire (if (equal mode "layered") (omnivox--choice-records-json choices)
                         (omnivox--native-choice-records-json choices)))
                 (row (list :id "heading" :shared (omnivox--choice-shared-json nil nil nil) :choices wire))
                 (content (list :definitions (vector (list :mode mode :definition row))
                                :choice-provenance (vector (list :logical-id "heading" :choices choices
                                                                 :choice-source 'portable))
                                :fallback_policy (list :global_default :null)))
                 (original (lambda (_) content)))
            (process-put phone 'iphone-wire nil)
            (should (eq content (iphone-voices--registration original phone)))
            (process-put phone 'iphone-wire t)
            (let* ((result (iphone-voices--registration original phone))
                   (definition (plist-get (aref (plist-get result :definitions) 0) :definition))
                   (rows (plist-get definition :choices))
                   (raw (plist-get (aref (plist-get result :choice-provenance) 0) :choices))
                   (ids (mapcar (lambda (r) (plist-get r :id)) rows)))
              (should (equal ids (list "loud" collision "soft" (concat collision "-1"))))
              (should (equal ids (mapcar (lambda (r) (plist-get r :id)) raw)))
              (should (equal (plist-get (aref rows 0) :adjustments) (plist-get (aref wire 1) :adjustments)))
              (should (equal (plist-get (aref rows 2) :adjustments) (plist-get (aref wire 2) :adjustments)))
              (should (zerop (hash-table-count (plist-get (aref rows 3) :adjustments))))
              (should (eq (plist-get (aref rows 3) :native) (and (equal mode "engine_layered") :null)))
              (should (equal (plist-get (plist-get result :fallback_policy) :global_default)
                             '(:kind "exact" :engine_id "ios" :voice_id "reading")))
              (should (= 3 (length (plist-get row :choices))))
              (should (eq :null (plist-get (plist-get content :fallback_policy) :global_default)))
              (let* ((retry (iphone-voices--registration (lambda (_) result) phone))
                     (again (plist-get (aref (plist-get retry :definitions) 0) :definition)))
                (should (equal ids (mapcar (lambda (r) (plist-get r :id))
                                           (plist-get again :choices))))))))
      (delete-process phone))))

(ert-deftest iphone-reading-keeps-authored-wildcards-and-full-role-lists ()
  (let* ((wildcard (omnivox--selector-json '(properties)))
         (definition (list :id "legacy-role" :preferences (vector wildcard)))
         (exact (lambda (id) (list :kind "exact" :engine_id "ios" :voice_id id))))
    (let ((omnivox-logical-voice-preferences nil))
      (should (equal (iphone-voices--legacy-preferences definition nil "reading" exact)
                     (vector (funcall exact "reading") wildcard))))
    (let ((omnivox-logical-voice-preferences '(("legacy-role" . ((properties))))))
      (should (equal (iphone-voices--legacy-preferences definition nil "reading" exact)
                     (vector wildcard (funcall exact "reading")))))
    (let* ((full (vconcat (cl-loop for n below 32 collect (funcall exact (number-to-string n)))))
           (definition (list :id "full" :preferences full)))
      (should (equal full (iphone-voices--legacy-preferences definition nil "reading" exact))))))

(ert-deftest iphone-registration-retains-the-legacy-wire-shape-and-choice-limit ()
  (let* ((phone (make-pipe-process :name "test legacy registration" :noquery t))
         (iphone-frame-speech--settings '(:reading "reed"))
         (rest (vconcat (cl-loop for n below 32 collect (list :kind "engine_default" :engine_id (number-to-string n))))))
    (unwind-protect
        (progn
          (process-put phone 'iphone-wire t)
          (dolist (wrapped '(nil t))
            (let* ((legacy (list :id "plain" :preferences rest))
                   (content (list :definitions (vector (if wrapped (list :mode "legacy" :definition legacy) legacy))
                                  :fallback_policy (list :global_default :null)))
                   (result (iphone-voices--registration (lambda (_) content) phone))
                   (row (aref (plist-get result :definitions) 0))
                   (prefs (plist-get (if wrapped (plist-get row :definition) row) :preferences)))
              (should (equal (plist-get (aref prefs 0) :voice_id) "reed"))
              (should (= 32 (length prefs)))
              (should (equal (aref prefs 31) (aref rest 30)))
              (should (equal (aref (plist-get legacy :preferences) 0) (aref rest 0))))))
      (delete-process phone))))

