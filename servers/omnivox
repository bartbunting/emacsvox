set -eu

server_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
program="$server_directory/omnivox-bin/current/omnivox.exe"

if [ ! -x "$program" ]; then
    echo "Omnivox Windows binary not found: $program; run 'make windows-omnivox' from the repository root" >&2
    exit 127
fi

# Resolve the content-addressed target before invoking WSL interop. Windows may
# otherwise reuse an older image while a process at the same path is running.
resolved_program=$(readlink -f -- "$program")

# WSL passes selected Linux variables to Windows programs through WSLENV.
# Preserve the caller's entries and add Omnivox's non-path compatibility
# settings once, including when an existing entry has WSLENV flags.
for variable in OMNIVOX_ENGINE OMNIVOX_AUDIO_TARGET \
    OMNIVOX_ELOQUENCE_HELPER OMNIVOX_ECI_DLL; do
    case ":${WSLENV-}:" in
        *":$variable:"*|*":$variable/"*) ;;
        *) WSLENV="${WSLENV:+$WSLENV:}$variable" ;;
    esac
done
export WSLENV

exec "$resolved_program" "$@"
