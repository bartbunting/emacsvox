set -eu

server_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
program="$server_directory/omnivox-bin/current/omnivox.exe"
windows_runtime=false
explicit_piper_model=${OMNIVOX_PIPER_MODEL-}
omnivox_config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
omnivox_config_file=${EMACSVOX_OMNIVOX_CONFIG_FILE:-"$omnivox_config_home/emacsvox/omnivox-program"}

if [ -n "${OMNIVOX_PROGRAM-}" ]; then
    resolved_program=$OMNIVOX_PROGRAM
    if [ ! -x "$resolved_program" ]; then
        echo "Configured Omnivox executable is not runnable: $resolved_program" >&2
        exit 127
    fi
    case $resolved_program in
        *.[eE][xX][eE]) windows_runtime=true ;;
    esac
elif [ -e "$omnivox_config_file" ]; then
    if [ ! -r "$omnivox_config_file" ]; then
        echo "Omnivox configuration is not readable: $omnivox_config_file" >&2
        exit 127
    fi
    resolved_program=$(sed -n '1p' "$omnivox_config_file")
    case $resolved_program in
        /*) ;;
        '')
            echo "Omnivox configuration is empty: $omnivox_config_file" >&2
            exit 127
            ;;
        *)
            echo "Omnivox configuration must contain an absolute path: $omnivox_config_file" >&2
            exit 127
            ;;
    esac
    if [ ! -x "$resolved_program" ]; then
        echo "Configured Omnivox executable is not runnable: $resolved_program" >&2
        exit 127
    fi
    case $resolved_program in
        *.[eE][xX][eE]) windows_runtime=true ;;
    esac
elif [ -x "$program" ]; then
    windows_runtime=true

    # Resolve the content-addressed target before invoking WSL interop. Windows
    # may otherwise reuse an older image while a process at the same path runs.
    resolved_program=$(readlink -f -- "$program")

    # Prefer the matching content-addressed runtime on the Windows filesystem.
    # Keep the WSL runtime as a compatibility fallback.
    windows_runtime_path_file="$server_directory/omnivox-bin/current/windows-runtime.path"
    if [ -r "$windows_runtime_path_file" ]; then
        windows_runtime_path=$(sed -n '1p' "$windows_runtime_path_file")
        if [ -n "$windows_runtime_path" ] &&
           windows_runtime_directory=$(wslpath -u "$windows_runtime_path"); then
            windows_program="$windows_runtime_directory/omnivox.exe"
            if [ -x "$windows_program" ]; then
                resolved_program=$(readlink -f -- "$windows_program")
            fi
        fi
    fi

    # Reading eSpeak's many small data files through \\wsl.localhost adds
    # several seconds to startup and to native voice discovery.
    espeak_data_path_file="$server_directory/omnivox-bin/current/espeak-ng-data.path"
    if [ -z "${ESPEAK_NG_DATA-}" ] && [ -r "$espeak_data_path_file" ]; then
        ESPEAK_NG_DATA=$(sed -n '1p' "$espeak_data_path_file")
        if [ -n "$ESPEAK_NG_DATA" ]; then
            export ESPEAK_NG_DATA
        fi
    fi

    # Development staging can record an external RHVoice installation without
    # copying its library or licensed voice data into the Omnivox payload.
    rhvoice_library_path_file="$server_directory/omnivox-bin/current/rhvoice-library.path"
    if [ -z "${OMNIVOX_RHVOICE_LIBRARY-}" ] &&
       [ -r "$rhvoice_library_path_file" ]; then
        OMNIVOX_RHVOICE_LIBRARY=$(sed -n '1p' "$rhvoice_library_path_file")
        if [ -n "$OMNIVOX_RHVOICE_LIBRARY" ]; then
            export OMNIVOX_RHVOICE_LIBRARY
        fi
    fi
    rhvoice_data_path_file="$server_directory/omnivox-bin/current/rhvoice-data.path"
    if [ -z "${OMNIVOX_RHVOICE_DATA-}" ] &&
       [ -r "$rhvoice_data_path_file" ]; then
        OMNIVOX_RHVOICE_DATA=$(sed -n '1p' "$rhvoice_data_path_file")
        if [ -n "$OMNIVOX_RHVOICE_DATA" ]; then
            export OMNIVOX_RHVOICE_DATA
        fi
    fi
    rhvoice_config_path_file="$server_directory/omnivox-bin/current/rhvoice-config.path"
    if [ -z "${OMNIVOX_RHVOICE_CONFIG-}" ] &&
       [ -r "$rhvoice_config_path_file" ]; then
        OMNIVOX_RHVOICE_CONFIG=$(sed -n '1p' "$rhvoice_config_path_file")
        if [ -n "$OMNIVOX_RHVOICE_CONFIG" ]; then
            export OMNIVOX_RHVOICE_CONFIG
        fi
    fi

    # A locally staged Piper model remains separate from the runtime payload,
    # but the staging target records its Windows-readable content-addressed
    # path so each new speech process can discover it without shell setup.
    piper_model_path_file="$server_directory/omnivox-bin/current/piper-model.path"
    if [ -z "${OMNIVOX_PIPER_MODEL-}" ] && [ -r "$piper_model_path_file" ]; then
        OMNIVOX_PIPER_MODEL=$(sed -n '1p' "$piper_model_path_file")
        if [ -n "$OMNIVOX_PIPER_MODEL" ]; then
            export OMNIVOX_PIPER_MODEL
            OMNIVOX_LAUNCHER_PIPER_DEFAULT=$OMNIVOX_PIPER_MODEL
            export OMNIVOX_LAUNCHER_PIPER_DEFAULT
        fi
    fi
else
    resolved_program=$(command -v omnivox 2>/dev/null || :)
    if [ -z "$resolved_program" ] || [ "$resolved_program" -ef "$0" ]; then
        echo "Omnivox executable not found on PATH; install an Omnivox release," >&2
        echo "set OMNIVOX_PROGRAM, or build the WSL2 runtime" >&2
        exit 127
    fi
fi

# Private per-Emacs-profile settings use paths visible to Emacs.  Convert only
# after resolving the actual native target; explicit native environment values
# keep precedence.  These inputs are data, never shell source.
local_engine_path() {
    case $1 in /*) ;; *) echo "Engine setting needs an absolute local path" >&2; return 1 ;; esac
    if $windows_runtime; then wslpath -w "$1"; else printf '%s\n' "$1"; fi
}
local_engine_export() {
    export "$1"
    if $windows_runtime; then
        # Generated values are already native paths and path lists.  Do not
        # translate them a second time through inherited WSLENV /p or /l flags.
        local_env_remaining="${WSLENV-}:"
        local_env_result=
        while [ -n "$local_env_remaining" ]; do
            local_env_entry=${local_env_remaining%%:*}
            local_env_remaining=${local_env_remaining#*:}
            case $local_env_entry in "$1"/*) local_env_entry=$1 ;; esac
            local_env_result="${local_env_result:+$local_env_result:}$local_env_entry"
        done
        WSLENV=$local_env_result
    fi
}
if [ -z "${OMNIVOX_ESPEAK_VARIANTS-}" ] && [ -n "${EMACSVOX_LOCAL_ESPEAK_VARIANTS-}" ]; then
    OMNIVOX_ESPEAK_VARIANTS=$EMACSVOX_LOCAL_ESPEAK_VARIANTS
    local_engine_export OMNIVOX_ESPEAK_VARIANTS
fi
if [ -z "$explicit_piper_model" ] && [ -n "${EMACSVOX_LOCAL_PIPER_MODEL-}" ]; then
    OMNIVOX_PIPER_MODEL=$(local_engine_path "$EMACSVOX_LOCAL_PIPER_MODEL")
    local_engine_export OMNIVOX_PIPER_MODEL
fi
if [ -z "${OMNIVOX_ECI_DLL-}${EMACSVOX_ECI_DLL-}" ] && [ -n "${EMACSVOX_LOCAL_ECI_DLL-}" ]; then
    OMNIVOX_ECI_DLL=$(local_engine_path "$EMACSVOX_LOCAL_ECI_DLL")
    local_engine_export OMNIVOX_ECI_DLL
fi
if [ -z "${OMNIVOX_DECTALK_DLL-}${EMACSVOX_DECTALK_DLL-}" ] && [ -n "${EMACSVOX_LOCAL_DECTALK_DLL-}" ]; then
    OMNIVOX_DECTALK_DLL=$(local_engine_path "$EMACSVOX_LOCAL_DECTALK_DLL")
    local_engine_export OMNIVOX_DECTALK_DLL
fi
if [ -z "${OMNIVOX_FLITE_VOICES-}" ] && [ -n "${EMACSVOX_LOCAL_FLITE_VOICES-}" ]; then
    local_flite_voices=
    local_path_separator=:
    if $windows_runtime; then local_path_separator=';'; fi
    while IFS= read -r local_voice_file; do
        [ -n "$local_voice_file" ] || continue
        local_voice_native=$(local_engine_path "$local_voice_file")
        local_flite_voices="${local_flite_voices:+$local_flite_voices$local_path_separator}$local_voice_native"
    done <<EOF
$EMACSVOX_LOCAL_FLITE_VOICES
EOF
    OMNIVOX_FLITE_VOICES=$local_flite_voices
    local_engine_export OMNIVOX_FLITE_VOICES
fi

# Let the top-level Emacsvox launcher validate the selected runtime without
# starting it, producing audio, or creating a diagnostic-log session.  This is
# an internal contract between the two tracked launchers, not an Omnivox CLI
# option forwarded to the native executable.
if [ "${EMACSVOX_OMNIVOX_PROBE_ONLY-}" = 1 ]; then
    printf '%s\n' "$resolved_program"
    exit 0
fi

# Preserve diagnostics outside Emacs: speech servers normally have no process
# buffer, so stderr would otherwise be discarded.  Each launch streams into
# line-aware bounded parts.  Closed logs are retained within both aggregate
# file-count and byte limits; live write targets remain protected when they
# exceed either cap.
omnivox_service=false
if [ "${EMACSVOX_OMNIVOX_DIAGNOSTIC-}" = 1 ]; then
    # Explicit isolated checks retain stderr with their own operation result.
    omnivox_service=true
    printf 'Omnivox check target: %s\n' "$resolved_program" >&2
fi
for omnivox_argument do
    case $omnivox_argument in --serve) omnivox_service=true ;; esac
done
# A foreground service needs visible listen/startup diagnostics in its terminal.
omnivox_state_directory=${XDG_STATE_HOME:-"$HOME/.local/state"}
omnivox_log_directory=${OMNIVOX_LOG_DIRECTORY:-"$omnivox_state_directory/emacsvox/omnivox"}
omnivox_log_max_file_bytes=${OMNIVOX_LOG_MAX_FILE_BYTES:-16777216}
omnivox_log_retained_files=${OMNIVOX_LOG_RETAINED_FILES:-16}
omnivox_log_retained_bytes=${OMNIVOX_LOG_RETAINED_BYTES:-268435456}
omnivox_session_id=$(date -u +%Y%m%dT%H%M%SZ)-$$

# The logging path is passed to POSIX utilities without relying on a GNU-style
# `--' option terminator.  Normalize it so option-like relative names are safe.
case $omnivox_log_directory in
    /*) ;;
    *) omnivox_log_directory=$(pwd)/$omnivox_log_directory ;;
esac

case $omnivox_log_max_file_bytes in
    ''|*[!0-9]*|0) omnivox_log_max_file_bytes=16777216 ;;
esac
case $omnivox_log_retained_files in
    ''|*[!0-9]*|0) omnivox_log_retained_files=16 ;;
esac
case $omnivox_log_retained_bytes in
    ''|*[!0-9]*|0) omnivox_log_retained_bytes=268435456 ;;
esac

if ! $omnivox_service && (umask 077 && mkdir -p "$omnivox_log_directory"); then
    chmod 700 "$omnivox_log_directory" 2>/dev/null || :
    log_filter="$server_directory/omnivox-log-filter"
    export OMNIVOX_LOG_FILTER_DIRECTORY="$omnivox_log_directory"
    export OMNIVOX_LOG_RETAINED_FILES="$omnivox_log_retained_files"
    export OMNIVOX_LOG_RETAINED_BYTES="$omnivox_log_retained_bytes"
    if [ -x "$log_filter" ]; then
        "$log_filter" --prune-only || :
    fi

    log_fifo="$omnivox_log_directory/.omnivox-$omnivox_session_id.pipe"
    if [ -x "$log_filter" ] && mkfifo -m 600 "$log_fifo"
    then
        log_prefix="$omnivox_log_directory/omnivox-$omnivox_session_id-part"
        (
            umask 077
            exec "$log_filter" --stream \
                "$log_prefix" "$omnivox_log_max_file_bytes"
        ) <"$log_fifo" >/dev/null 2>/dev/null &
        trap 'unlink "$log_fifo" 2>/dev/null || :' 0 1 2 15
        exec 2>"$log_fifo"
        unlink "$log_fifo"
        trap - 0 1 2 15
    else
        omnivox_log_file="$omnivox_log_directory/omnivox-$omnivox_session_id.log"
        (umask 077 && : >>"$omnivox_log_file")
        chmod 600 "$omnivox_log_file"
        exec 2>>"$omnivox_log_file"
    fi
    printf '%s session_start session_id=%s launcher_pid=%s program=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$omnivox_session_id" "$$" \
        "$resolved_program" >&2
elif ! $omnivox_service; then
    echo "Could not create Omnivox log directory: $omnivox_log_directory" >&2
fi

if $windows_runtime; then
    # WSL passes selected Linux variables to Windows programs through WSLENV.
    # Preserve existing entries and add Omnivox's compatibility settings once.
    for variable in OMNIVOX_ENGINE OMNIVOX_AUDIO_TARGET OMNIVOX_AUDIO_OUTPUT \
        OMNIVOX_VOICE_ROOT OMNIVOX_VOICE_LIBRARY OMNIVOX_LAUNCHER_PIPER_DEFAULT \
        OMNIVOX_OWNED_STARTUP OMNIVOX_OWNED_STARTUP_SHA256 OMNIVOX_OWNED_LIBRARY \
        OMNIVOX_REMOTE_NOTIFICATION_TARGET \
        OMNIVOX_LOG_SYNTHESIS_TEXT \
        OMNIVOX_ELOQUENCE_HELPER OMNIVOX_ECI_DLL \
        EMACSVOX_ECI_DLL EMACSVOX_DECTALK_DLL \
        OMNIVOX_DECTALK_HELPER OMNIVOX_DECTALK_DLL \
        OMNIVOX_RHVOICE_HELPER OMNIVOX_RHVOICE_LIBRARY \
        OMNIVOX_RHVOICE_DATA OMNIVOX_RHVOICE_CONFIG \
        OMNIVOX_RHVOICE_RESOURCES \
        OMNIVOX_FLITE_HELPER OMNIVOX_FLITE_VOICES OMNIVOX_ESPEAK_VARIANTS \
        OMNIVOX_RUTTS_HELPER \
        OMNIVOX_TGSPEECHBOX_HELPER OMNIVOX_TGSPEECHBOX_DATA \
        OMNIVOX_TGSPEECHBOX_SAMPLE_RATE \
        OMNIVOX_PIPER_MODEL OMNIVOX_PIPER_HELPER \
        OMNIVOX_PIPER_ESPEAK_DATA ESPEAK_NG_DATA; do
        case ":${WSLENV-}:" in
            *":$variable:"*|*":$variable/"*) ;;
            *) WSLENV="${WSLENV:+$WSLENV:}$variable" ;;
        esac
    done
    export WSLENV
fi

exec "$resolved_program" "$@"
