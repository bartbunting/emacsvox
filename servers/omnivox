set -eu

server_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
program="$server_directory/omnivox-bin/current/omnivox.exe"

if [ ! -x "$program" ]; then
    echo "Omnivox Windows binary not found: $program; run 'make windows-omnivox' from the repository root" >&2
    exit 127
fi

# Resolve the content-addressed target before invoking WSL interop. Windows may
# otherwise reuse an older image while a process at the same path is running.
resolved_program=$(readlink -f -- "$program")

# Prefer the matching content-addressed runtime on the Windows filesystem.
# This avoids Windows loading the executable, DLLs, and helper processes over
# the WSL network share. Keep the WSL runtime as a compatibility fallback.
windows_runtime_path_file="$server_directory/omnivox-bin/current/windows-runtime.path"
if [ -r "$windows_runtime_path_file" ]; then
    windows_runtime_path=$(sed -n '1p' "$windows_runtime_path_file")
    if [ -n "$windows_runtime_path" ] &&
       windows_runtime_directory=$(wslpath -u "$windows_runtime_path"); then
        windows_program="$windows_runtime_directory/omnivox.exe"
        if [ -x "$windows_program" ]; then
            resolved_program=$(readlink -f -- "$windows_program")
        fi
    fi
fi

# The Windows build stages eSpeak's many small data files on the Windows
# filesystem. Reading them through \\wsl.localhost adds several seconds to
# startup and to any native voice discovery.
espeak_data_path_file="$server_directory/omnivox-bin/current/espeak-ng-data.path"
if [ -z "${ESPEAK_NG_DATA-}" ] && [ -r "$espeak_data_path_file" ]; then
    ESPEAK_NG_DATA=$(sed -n '1p' "$espeak_data_path_file")
    if [ -n "$ESPEAK_NG_DATA" ]; then
        export ESPEAK_NG_DATA
    fi
fi

# Preserve diagnostics outside Emacs: speech servers normally have no process
# buffer, so stderr would otherwise be discarded.  A distinct file per launch
# keeps concurrent Emacs instances and restarts separate.
omnivox_state_directory=${XDG_STATE_HOME:-"$HOME/.local/state"}
omnivox_log_directory=${OMNIVOX_LOG_DIRECTORY:-"$omnivox_state_directory/emacsvox/omnivox"}
omnivox_session_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
if mkdir -p -- "$omnivox_log_directory"; then
    omnivox_log_file="$omnivox_log_directory/omnivox-$omnivox_session_id.log"
    (umask 077 && : >>"$omnivox_log_file")
    chmod 600 -- "$omnivox_log_file"
    exec 2>>"$omnivox_log_file"
    printf '%s session_start session_id=%s launcher_pid=%s program=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$omnivox_session_id" "$$" \
        "$resolved_program" >&2
else
    echo "Could not create Omnivox log directory: $omnivox_log_directory" >&2
fi

# WSL passes selected Linux variables to Windows programs through WSLENV.
# Preserve the caller's entries and add Omnivox's non-path compatibility
# settings once, including when an existing entry has WSLENV flags.
for variable in OMNIVOX_ENGINE OMNIVOX_AUDIO_TARGET \
    OMNIVOX_LOG_SYNTHESIS_TEXT \
    OMNIVOX_ELOQUENCE_HELPER OMNIVOX_ECI_DLL \
    OMNIVOX_DECTALK_HELPER OMNIVOX_DECTALK_DLL ESPEAK_NG_DATA; do
    case ":${WSLENV-}:" in
        *":$variable:"*|*":$variable/"*) ;;
        *) WSLENV="${WSLENV:+$WSLENV:}$variable" ;;
    esac
done
export WSLENV

exec "$resolved_program" "$@"
