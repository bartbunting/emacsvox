.............................................

 -- Command: emacsvox-muggles-info-summary/body

     Call the body in the "emacsvox-muggles-info-summary" hydra.

     The heads for the associated hydra are:

     "]":    ‘Info-forward-node’,
     "[":    ‘Info-backward-node’,
     "n":    ‘Info-next’,
     "p":    ‘Info-prev’,
     "s":    ‘Info-search’,
     "S":    ‘Info-search-case-sensitively’,
     "l":    ‘Info-history-back’,
     "r":    ‘Info-history-forward’,
     "H":    ‘Info-history’,
     "t":    ‘Info-top-node’,
     "<":    ‘Info-top-node’,
     ">":    ‘Info-final-node’,
     "u":    ‘Info-up’,
     "^":    ‘Info-up’,
     "m":    ‘Info-menu’,
     "g":    ‘Info-goto-node’,
     "b":    ‘beginning-of-buffer’,
     "e":    ‘end-of-buffer’,
     "f":    ‘Info-follow-reference’,
     "i":    ‘Info-index’,
     ",":    ‘Info-index-next’,
     "I":    ‘Info-virtual-index’,
     "T":    ‘Info-toc’,
     "d":    ‘Info-directory’,
     "c":    ‘Info-copy-current-node-name’,
     "C":    ‘clone-buffer’,
     "a":    ‘info-apropos’,
     "1":    ‘Info-nth-menu-item’,
     "2":    ‘Info-nth-menu-item’,
     "3":    ‘Info-nth-menu-item’,
     "4":    ‘Info-nth-menu-item’,
     "5":    ‘Info-nth-menu-item’,
     "6":    ‘Info-nth-menu-item’,
     "7":    ‘Info-nth-menu-item’,
     "8":    ‘Info-nth-menu-item’,
     "9":    ‘Info-nth-menu-item’,
     "?":    ‘Info-summary’,
     "h":    ‘Info-help’,
     "q":    ‘quit-window’,
