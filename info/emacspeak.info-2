     "?":    ‘(emacsvox-hydra-self-help "emacsvox-muggles-brightness")’,
     "s":    ‘light-set’,
     "g":    ‘light-get’,
     "t":    ‘emacsvox-hydra-toggle-talkative’,
     "<print>":    ‘light-black’,
     "s-.":    ‘light-black’,
     ".":    ‘light-black’,
     "0":    ‘light-black’,
     "1":    ‘light-white’,
     "d":    ‘light-decrement’,
