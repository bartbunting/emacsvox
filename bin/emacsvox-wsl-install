#!/bin/sh

# Copyright (C) 2026 Emacsvox contributors
# SPDX-License-Identifier: GPL-2.0-or-later
#
# This file is part of Emacsvox.
# shellcheck source-path=SCRIPTDIR

set -eu

program_name=emacsvox-wsl-install
mode=install
audio_check=true
build_emacs=false

usage()
{
    cat <<'EOF'
Usage: bin/emacsvox-wsl-install [OPTION ...]

Prepare the supported WSL2 installation of Emacsvox and the verified Omnivox
Windows release.  The installer makes only per-user changes.  It never invokes
sudo or edits a shell startup file.

Options:
  --check           inspect prerequisites and planned paths without changes
  --no-audio-check  install and diagnose, but do not play the final check
  --build-emacs     choose the pinned Emacs source build instead of PATH
  -h, --help        show this help and exit

When Emacs 30.2 or newer is unavailable, the installer suggests a suitable apt
package or offers --build-emacs to build the pinned GNU Emacs below ~/.local/opt.
Missing Ubuntu build packages are reported for the user to review and install.
EOF
}

fail()
{
    printf '%s: %s\n' "$program_name" "$1" >&2
    exit "${2:-1}"
}

note()
{
    printf '\n%s\n' "$1"
}

while [ "$#" -gt 0 ]; do
    case $1 in
        --check)
            mode=check
            ;;
        --no-audio-check)
            audio_check=false
            ;;
        --build-emacs)
            build_emacs=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            fail "unknown option: $1" 2
            ;;
    esac
    shift
done

script_directory=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) ||
    fail "cannot resolve the installer directory"
emacsvox_root=$(CDPATH='' cd -- "$script_directory/.." && pwd) ||
    fail "cannot resolve the Emacsvox checkout"
manifest=$emacsvox_root/etc/wsl-install.conf
[ -r "$manifest" ] || fail "missing release manifest: $manifest"
# The manifest is maintained in the same trusted source tree as this script.
# The resolved manifest is in this trusted checkout.
# shellcheck disable=SC1090
. "$manifest"
# Shared Emacs acquisition; the WSL desktop policy stays in this entry point.
# shellcheck source=../utils/emacsvox-install-common.sh
. "$emacsvox_root/utils/emacsvox-install-common.sh"

[ "${EMACSVOX_WSL_INSTALL_SCHEMA-}" = 1 ] ||
    fail "unsupported WSL installation manifest schema"
validate_hash "$EMACSVOX_WSL_EMACS_SHA256"
validate_hash "$EMACSVOX_WSL_OMNIVOX_WINDOWS_X64_SHA256"
validate_hash "$EMACSVOX_WSL_OMNIVOX_WINDOWS_ARM64_SHA256"

proc_version_file=${EMACSVOX_WSL_PROC_VERSION_FILE:-/proc/version}
if [ ! -r "$proc_version_file" ] ||
   ! grep -qi microsoft "$proc_version_file"; then
    fail "this installer supports Emacs running under WSL2"
fi
if [ -r /proc/sys/kernel/osrelease ] &&
   grep -qi microsoft-standard-WSL /proc/sys/kernel/osrelease; then
    :
elif [ -z "${WSL_INTEROP-}" ]; then
    fail "WSL2 with Windows interoperability enabled is required"
fi

missing_interoperation_tools=
for tool in powershell.exe wslpath; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        missing_interoperation_tools="${missing_interoperation_tools}${missing_interoperation_tools:+ }$tool"
    fi
done
if [ -n "$missing_interoperation_tools" ]; then
    fail "WSL interoperability is missing required commands: $missing_interoperation_tools"
fi

windows_architecture=${EMACSVOX_WSL_WINDOWS_ARCHITECTURE-}
if [ -z "$windows_architecture" ]; then
    windows_architecture=$(
        powershell.exe -NoProfile -NonInteractive -Command \
            '[System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString()' |
            tr -d '\r'
    ) || fail "could not determine the Windows architecture"
fi
case $windows_architecture in
    X64|x64|AMD64|amd64)
        omnivox_platform=windows-x64
        omnivox_archive=$EMACSVOX_WSL_OMNIVOX_WINDOWS_X64_ARCHIVE
        omnivox_sha256=$EMACSVOX_WSL_OMNIVOX_WINDOWS_X64_SHA256
        ;;
    Arm64|ARM64|arm64)
        omnivox_platform=windows-arm64
        omnivox_archive=$EMACSVOX_WSL_OMNIVOX_WINDOWS_ARM64_ARCHIVE
        omnivox_sha256=$EMACSVOX_WSL_OMNIVOX_WINDOWS_ARM64_SHA256
        ;;
    *) fail "unsupported Windows architecture: $windows_architecture" ;;
esac

windows_local_app_data=${EMACSVOX_WSL_WINDOWS_LOCAL_APP_DATA-}
if [ -z "$windows_local_app_data" ]; then
    windows_local_app_data=$(
        powershell.exe -NoProfile -NonInteractive -Command \
            '[Environment]::GetFolderPath("LocalApplicationData")' | tr -d '\r'
    ) || fail "could not locate Windows LocalAppData"
fi
[ -n "$windows_local_app_data" ] || fail "Windows LocalAppData is empty"
windows_local_app_data_wsl=$(wslpath -u "$windows_local_app_data") ||
    fail "could not translate Windows LocalAppData for WSL"
omnivox_install_directory=$windows_local_app_data_wsl/Emacsvox/Omnivox/releases/$EMACSVOX_WSL_OMNIVOX_VERSION-$omnivox_platform
omnivox_program=$omnivox_install_directory/omnivox.exe

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
omnivox_config_directory=$config_home/emacsvox
omnivox_config_file=$omnivox_config_directory/omnivox-program
cache_home=${XDG_CACHE_HOME:-"$HOME/.cache"}
download_directory=$cache_home/emacsvox/downloads
emacs_install_directory=$HOME/.local/opt/emacs-$EMACSVOX_WSL_EMACS_VERSION

resolve_emacs
if ! $emacs_supported &&
   { [ "$emacs_selection" = 'EMACS environment variable' ] ||
     [ "$emacs_selection" = local.mk ]; }; then
    fail "$emacs_selection selects unsupported Emacs ${selected_emacs_version:-unknown}; preserve or update that explicit setting before continuing"
fi
if $build_emacs; then
    case $emacs_selection in
        'EMACS environment variable'|local.mk)
            fail '--build-emacs cannot replace an explicit Emacs selection; unset or align it first' ;;
    esac
    emacs_supported=false
fi
if ! $emacs_supported && ! $build_emacs; then
    emacs_package=emacs
    build_command='./bin/emacsvox-wsl-install --build-emacs'
    if ! $audio_check; then build_command="$build_command --no-audio-check"; fi
    offer_emacs_acquisition
    exit 2
fi

required_packages='curl make coreutils tar unzip'
emacs_build_packages='build-essential pkg-config texinfo xz-utils libgtk-3-dev libgnutls28-dev libtree-sitter-dev libjansson-dev libncurses-dev libxml2-dev libsqlite3-dev libacl1-dev libharfbuzz-dev libotf-dev libxpm-dev libjpeg-dev libpng-dev libgif-dev libtiff-dev librsvg2-dev libwebp-dev libasound2-dev libgmp-dev'
if ! $emacs_supported; then
    required_packages="$required_packages $emacs_build_packages"
fi
missing_packages=
for package in $required_packages; do
    if ! command -v dpkg-query >/dev/null 2>&1; then
        case $package in
            curl) command -v curl >/dev/null 2>&1 || missing_packages="$missing_packages curl" ;;
            make) command -v make >/dev/null 2>&1 || missing_packages="$missing_packages make" ;;
            coreutils) command -v sha256sum >/dev/null 2>&1 || missing_packages="$missing_packages coreutils" ;;
            tar) command -v tar >/dev/null 2>&1 || missing_packages="$missing_packages tar" ;;
            unzip) command -v unzip >/dev/null 2>&1 || missing_packages="$missing_packages unzip" ;;
            *)
                fail "automatic Emacs installation currently requires an Ubuntu or Debian WSL distribution"
                ;;
        esac
    elif ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null |
         grep -qx 'install ok installed'; then
        case " $missing_packages " in
            *" $package "*) ;;
            *) missing_packages="${missing_packages}${missing_packages:+ }$package" ;;
        esac
    fi
done
if ! $emacs_supported && ! command -v dpkg-query >/dev/null 2>&1; then
    command -v dpkg-query >/dev/null 2>&1 ||
        fail "automatic Emacs installation currently requires an Ubuntu or Debian WSL distribution"
fi

note "WSL installation plan"
printf '  Emacsvox checkout: %s\n' "$emacsvox_root"
if $emacs_supported; then
    printf '  Emacs: %s (%s, selected by %s)\n' \
        "$emacs_candidate" "$selected_emacs_version" "$emacs_selection"
else
    printf '  Emacs: build verified GNU Emacs %s into %s\n' \
        "$EMACSVOX_WSL_EMACS_VERSION" "$emacs_install_directory"
fi
printf '  Omnivox: %s %s into %s\n' \
    "$EMACSVOX_WSL_OMNIVOX_VERSION" "$omnivox_platform" \
    "$omnivox_install_directory"
printf '  Persistent selection: %s\n' "$omnivox_config_file"

install_options=
if $build_emacs; then install_options=' --build-emacs'; fi
if ! $audio_check; then install_options="$install_options --no-audio-check"; fi
if [ -n "$missing_packages" ]; then
    cat <<EOF

The supported WSL installation needs additional packages.  Review and run:

  sudo apt update
  sudo apt install $missing_packages

Then run ./bin/$program_name$install_options again.  No packages were installed automatically.
EOF
    exit 2
fi

if [ "$mode" = check ]; then
    installed_omnivox_current=false
    if [ -x "$omnivox_program" ]; then
        installed_omnivox_version=$(
            "$omnivox_program" --version 2>/dev/null | sed -n '1p'
        ) || :
        printf '  Installed Omnivox: %s\n' \
            "${installed_omnivox_version:-not runnable}"
        case $installed_omnivox_version in
            *" $EMACSVOX_WSL_OMNIVOX_VERSION")
                installed_omnivox_current=true
                ;;
        esac
    else
        printf '  Installed Omnivox: not present; the installer will add it\n'
    fi
    configured_omnivox_program=
    if [ -r "$omnivox_config_file" ]; then
        configured_omnivox_program=$(sed -n '1p' "$omnivox_config_file")
    fi
    if $installed_omnivox_current &&
       [ "$configured_omnivox_program" = "$omnivox_program" ]; then
        printf '\nNo files were changed.  Omnivox %s is already installed and selected.\n' \
            "$EMACSVOX_WSL_OMNIVOX_VERSION"
    elif $installed_omnivox_current; then
        printf '\nNo files were changed.  Run ./bin/%s%s to record and verify this installation.\n' \
            "$program_name" "$install_options"
    else
        printf '\nNo files were changed.  Run ./bin/%s%s to install.\n' "$program_name" "$install_options"
    fi
    exit 0
fi

cleanup_build_directory=
cleanup_omnivox_directory=
cleanup()
{
    if [ -n "$cleanup_build_directory" ]; then
        case $cleanup_build_directory in
            "${TMPDIR:-/tmp}"/emacsvox-emacs-*)
                rm -rf -- "$cleanup_build_directory"
                ;;
        esac
    fi
    if [ -n "$cleanup_omnivox_directory" ]; then
        case $cleanup_omnivox_directory in
            "$windows_local_app_data_wsl"/Emacsvox/Omnivox/releases/.install-*)
                rm -rf -- "$cleanup_omnivox_directory"
                ;;
            "$omnivox_install_directory")
                rm -rf -- "$cleanup_omnivox_directory"
                ;;
        esac
    fi
}
trap cleanup 0 1 2 15

if ! $emacs_supported; then
    install_emacs
fi

configure_local_emacs

install_omnivox()
{
    if [ -x "$omnivox_program" ]; then
        installed_version=$("$omnivox_program" --version 2>/dev/null || :)
        case $installed_version in
            *" $EMACSVOX_WSL_OMNIVOX_VERSION")
                [ -d "$omnivox_install_directory/espeak-ng-data" ] ||
                    fail "existing Omnivox installation lacks espeak-ng-data"
                printf 'Using existing %s.\n' "$installed_version"
                return
                ;;
        esac
        fail "existing Omnivox installation is not version $EMACSVOX_WSL_OMNIVOX_VERSION: $omnivox_install_directory"
    elif [ -e "$omnivox_install_directory" ]; then
        fail "existing Omnivox installation is incomplete: $omnivox_install_directory"
    fi

    archive=$download_directory/$omnivox_archive
    download_verified \
        "$EMACSVOX_WSL_OMNIVOX_RELEASE_URL/$omnivox_archive" \
        "$archive" "$omnivox_sha256"
    install_parent=$(dirname -- "$omnivox_install_directory")
    mkdir -p -- "$install_parent"
    staging_directory=$install_parent/.install-$EMACSVOX_WSL_OMNIVOX_VERSION-$omnivox_platform-$$
    [ ! -e "$staging_directory" ] ||
        fail "temporary Omnivox directory already exists: $staging_directory"
    mkdir -- "$staging_directory"
    cleanup_omnivox_directory=$staging_directory
    unzip -q "$archive" -d "$staging_directory"
    [ -f "$staging_directory/omnivox.exe" ] ||
        fail "the verified Omnivox archive has an unexpected layout"
    [ -d "$staging_directory/espeak-ng-data" ] ||
        fail "the verified Omnivox archive lacks espeak-ng-data"
    chmod 755 "$staging_directory/omnivox.exe"
    # Rename the complete tree before starting its Windows executable.  DrvFS
    # can temporarily refuse to rename a directory from which an executable
    # has just run, even after that process has exited.
    mv -- "$staging_directory" "$omnivox_install_directory"
    cleanup_omnivox_directory=$omnivox_install_directory
    staged_version=$("$omnivox_program" --version 2>/dev/null || :)
    case $staged_version in
        *" $EMACSVOX_WSL_OMNIVOX_VERSION") ;;
        *) fail "the staged Omnivox executable reports an unexpected version" ;;
    esac
    cleanup_omnivox_directory=
    printf 'Installed %s.\n' "$staged_version"
}

install_omnivox

mkdir -p -- "$omnivox_config_directory"
chmod 700 "$omnivox_config_directory" 2>/dev/null || :
config_temporary=$omnivox_config_file.tmp.$$
printf '%s\n' "$omnivox_program" >"$config_temporary"
chmod 600 "$config_temporary"
mv -f -- "$config_temporary" "$omnivox_config_file"
printf 'Recorded the Omnivox path in %s.\n' "$omnivox_config_file"

note 'Compiling Emacsvox'
compile_log=$cache_home/emacsvox/logs/emacsvox-bytecode.log
mkdir -p -- "$(dirname -- "$compile_log")"
: >"$compile_log"
chmod 600 "$compile_log"
if ! make -C "$emacsvox_root" EMACS="$emacs_candidate" bytecode-rebuild \
     >"$compile_log" 2>&1; then
    tail -n 30 "$compile_log" >&2
    fail "Emacsvox compilation failed; complete output is in $compile_log"
fi
printf 'Compiled Emacsvox; build details are in %s.\n' "$compile_log"

note 'Checking the installed launch path'
env -u EMACS -u EMACSVOX_DIR -u OMNIVOX_PROGRAM -u TTS_PROGRAM \
    "$emacsvox_root/bin/emacsvox" --diagnose
if $audio_check; then
    env -u EMACS -u EMACSVOX_DIR -u OMNIVOX_PROGRAM -u TTS_PROGRAM \
        "$emacsvox_root/bin/emacsvox" --check
fi

cat <<EOF

WSL installation complete.

Start an isolated Emacsvox session with:

  $emacsvox_root/bin/emacsvox

The Omnivox selection is persistent and does not depend on a shell startup file.
EOF
