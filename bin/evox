#!/bin/sh

set -eu

script_directory=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
launcher=$script_directory/emacsvox

printf '%s\n' \
    'evox: deprecated; use bin/emacsvox (evox will be removed after Emacsvox 60)' \
    >&2
if [ "${EMACSVOX_INIT_DIRECTORY+x}" = x ]; then
    printf '%s\n' \
        'evox: EMACSVOX_INIT_DIRECTORY is no longer used; the supported launcher starts an isolated session' \
        >&2
fi

if [ ! -x "$launcher" ]; then
    printf 'evox: replacement launcher is not executable: %s\n' "$launcher" >&2
    exit 127
fi

exec "$launcher" "$@"
